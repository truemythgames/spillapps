{
  "expo": {
    "name": "Bible Tea",
    "slug": "bibletea",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "bibletea",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bibletea",
      "buildNumber": "77",
      "appleTeamId": "T8QBXL5U75",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "app.bibletea",
      "versionCode": 77,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-dev-client",
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0F",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "4486535591581092",
          "clientToken": "6379a60fe0a2316f4db0f45127d2f3c7",
          "displayName": "Bible Tea",
          "scheme": "fb4486535591581092",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": false,
          "iosUserTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "./plugins/firebase-modular-headers",
      "./plugins/hermes-dsym-plugin",
      "./plugins/now-playing-plugin",
      "./plugins/verse-widget-plugin",
      "./plugins/android-verse-widget-plugin",
      "expo-tracking-transparency",
      "./plugins/android-16-compat"

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_medium">

    <ImageView
        android:id="@+id/cover_image"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Story cover" />

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/verse_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:text="VERSE OF THE DAY"
            android:textColor="#FFD166"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/verse_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/verse_label"
            android:layout_above="@id/verse_ref"
            android:layout_marginTop="6dp"
            android:text="Trust in the Lord with all your heart."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:maxLines="3"
            android:ellipsize="end"
            android:gravity="start" />

        <TextView
            android:id="@+id/verse_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/tap_hint"
            android:layout_marginBottom="4dp"
            android:text="Proverbs 3:5"
            android:textColor="#C8A2FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tap_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Tap to hear today's story"
            android:textColor="#A0A0B8"
            android:textSize="9sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/branding_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:text="🍵"
            android:textSize="12sp" />

    </RelativeLayout>

</LinearLayout>

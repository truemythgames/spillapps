---
import Base from "../layouts/Base.astro";
import StoreButtons from "./StoreButtons.astro";
import {
  getCatalog,
  getPlaylists,
  hasCover,
  coverUrl,
  sizedMedia,
} from "../lib/stories";
import { getLocale, localePath, t } from "../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const catalog = getCatalog(locale);
const playlists = await getPlaylists(catalog, locale);
const storeCampaign = locale === "es" ? "es-playlists" : "en-playlists";
const pageUrl = locale === "es" ? "https://bibletea.app/es/playlists/" : "https://bibletea.app/playlists/";
const homeUrl = locale === "es" ? "https://bibletea.app/es/" : "https://bibletea.app/";
const count = String(playlists.length);

const featuredIds = ["pl-love", "pl-miracles", "pl-jesus", "pl-easter", "pl-underdogs", "pl-women"];
const playlistMap = new Map(playlists.map((p) => [p.id, p]));
const featured = featuredIds.map((id) => playlistMap.get(id)).filter((p): p is NonNullable<typeof p> => Boolean(p));

const title = t(locale, "playlists.title");
const description = t(locale, "playlists.description");

const faqs = [
  { q: t(locale, "playlists.faqQ1"), a: t(locale, "playlists.faqA1").replace("{count}", count) },
  { q: t(locale, "playlists.faqQ2"), a: t(locale, "playlists.faqA2") },
  { q: t(locale, "playlists.faqQ3"), a: t(locale, "playlists.faqA3") },
  { q: t(locale, "playlists.faqQ4"), a: t(locale, "playlists.faqA4") },
  { q: t(locale, "playlists.faqQ5"), a: t(locale, "playlists.faqA5") },
  { q: t(locale, "playlists.faqQ6"), a: t(locale, "playlists.faqA6") },
];

function playlistCover(pl: (typeof playlists)[number]): string | null {
  if (pl.cover_image_url) return sizedMedia(pl.cover_image_url, 400);
  const withCover = pl.stories.find((s) => hasCover(s.id));
  return withCover ? coverUrl(withCover.id, 400) : null;
}

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(locale, "playlists.h1"),
  description,
  url: pageUrl,
  publisher: {
    "@type": "Organization",
    name: "Bible Tea",
    logo: { "@type": "ImageObject", url: "https://bibletea.app/icon.png" },
  },
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t(locale, "playlists.h1"),
  numberOfItems: playlists.length,
  itemListElement: playlists.map((pl, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "WebPage", name: pl.name, url: `https://bibletea.app${localePath(`/playlists/${pl.id}`, locale)}` },
  })),
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "playlist.breadcrumbHome"), item: homeUrl },
    { "@type": "ListItem", position: 2, name: t(locale, "playlist.breadcrumbPlaylists"), item: pageUrl },
  ],
};
---

<Base title={title} description={description} canonicalPath="/playlists" jsonLd={[collectionLd, itemListLd, faqLd, breadcrumbLd]}>
  <style>
    .bc { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); max-width: 1200px; margin: 0 auto; padding: 6.5rem 2rem 0; }
    .bc a { color: var(--text-muted); text-decoration: none; }
    .bc a:hover { color: var(--primary); }
    .bc .sep { opacity: 0.4; }
    .playlists-hero { padding: 2rem 2rem 1.25rem; text-align: center; max-width: 760px; margin: 0 auto; }
    .playlists-hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .playlists-hero p { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin: 1.25rem 0 0; }
    .about { max-width: 760px; margin: 0 auto 2rem; padding: 0 2rem; }
    .about h2, .featured h2, .faq-section h2, .bottom-cta h2, .playlist-header h2 {
      font-family: "Playfair Display", serif;
    }
    .about h2, .featured h2, .faq-section h2 { font-size: 1.5rem; margin: 0 0 0.6rem; }
    .about p { color: var(--text-secondary); line-height: 1.75; margin: 0 0 1rem; }
    .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin: 0 0 2.25rem; padding: 0 2rem; }
    .links a {
      display: inline-flex;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: 1px solid var(--surface-border);
      background: var(--surface);
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
    }
    .links a:hover { border-color: var(--primary); color: var(--primary); }
    .featured { max-width: 1200px; margin: 0 auto; padding: 0 2rem 1.5rem; }
    .featured p { color: var(--text-secondary); margin: 0 0 1.1rem; }
    .feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.85rem; }
    .feat-card { text-decoration: none; color: inherit; }
    .feat-cover { width: 100%; aspect-ratio: 1; border-radius: 14px; overflow: hidden; background: var(--surface); }
    .feat-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .feat-card h3 { font-size: 1rem; margin: 0.55rem 0 0.15rem; font-family: "Playfair Display", serif; }
    .feat-card span { color: var(--text-muted); font-size: 0.82rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .playlist-section { max-width: 1200px; margin: 0 auto; padding: 0 2rem 1.5rem; }
    .playlist-header { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.35rem; padding-top: 2rem; }
    .playlist-header a { text-decoration: none; color: inherit; }
    .playlist-header a:hover { color: var(--primary); }
    .playlist-header h2 { font-size: 1.4rem; }
    .see-all { font-size: 0.8rem; color: var(--primary); text-decoration: none; font-weight: 500; white-space: nowrap; }
    .playlist-desc { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem; }
    .story-row { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; padding-bottom: 0.75rem; scrollbar-width: none; }
    .story-row::-webkit-scrollbar { display: none; }
    .story-card { flex-shrink: 0; width: 180px; scroll-snap-align: start; text-decoration: none; }
    .story-card:hover { transform: translateY(-6px) scale(1.03); }
    .card-cover { width: 180px; height: 180px; border-radius: 14px; overflow: hidden; position: relative; margin-bottom: 0.5rem; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35); }
    .card-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .card-cover-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--surface) 0%, var(--surface-light) 100%); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
    .card-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 0.5rem 0.65rem; background: linear-gradient(transparent, rgba(0,0,0,0.8)); }
    .card-ref { font-size: 0.6rem; color: var(--accent); font-weight: 600; letter-spacing: 0.5px; }
    .card-title { font-family: "Playfair Display", serif; font-size: 0.85rem; font-weight: 700; color: var(--text); line-height: 1.25; margin-top: 0.3rem; }
    .card-desc { font-size: 0.72rem; color: var(--text-muted); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .faq-section { max-width: 700px; margin: 0 auto; padding: 1rem 2rem 3rem; }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.4rem; }
    .faq-item p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; margin: 0; }
    .bottom-cta { text-align: center; padding: 3rem 2rem 4rem; }
    .bottom-cta h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: 0.75rem; }
    .bottom-cta p { color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 450px; margin-left: auto; margin-right: auto; }
    @media (max-width: 900px) { .feat-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 640px) {
      .playlists-hero, .about, .featured, .playlist-section, .faq-section { padding-left: 1.25rem; padding-right: 1.25rem; }
      .feat-grid { grid-template-columns: 1fr; }
      .story-card, .card-cover { width: 150px; }
      .card-cover { height: 150px; }
    }
  </style>

  <main>
    <div class="bc" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "playlist.breadcrumbHome")}</a><span class="sep">/</span>
      <span>{t(locale, "playlist.breadcrumbPlaylists")}</span>
    </div>
    <div class="playlists-hero">
      <h1>{t(locale, "playlists.h1")}</h1>
      <StoreButtons variant="hero" campaign={storeCampaign} />
      <p>{t(locale, "playlists.subtitle")}</p>
    </div>

    <section class="about">
      <h2>{t(locale, "playlists.aboutTitle")}</h2>
      <p>{t(locale, "playlists.aboutP1")}</p>
      <p>{t(locale, "playlists.aboutP2")}</p>
    </section>

    <div class="links">
      <a href={localePath("/stories", locale)}>{t(locale, "playlists.linkStories")}</a>
      <a href={localePath("/bible-stories-for-adults", locale)}>{t(locale, "playlists.linkAdults")}</a>
      <a href={localePath("/bible-for-beginners", locale)}>{t(locale, "playlists.linkBeginners")}</a>
      <a href={localePath("/bible-app", locale)}>{t(locale, "playlists.linkApp")}</a>
    </div>

    {featured.length > 0 && (
      <section class="featured">
        <h2>{t(locale, "playlists.featuredTitle")}</h2>
        <p>{t(locale, "playlists.featuredSub")}</p>
        <div class="feat-grid">
          {featured.map((pl) => {
            const img = playlistCover(pl);
            return (
              <a class="feat-card" href={localePath(`/playlists/${pl.id}`, locale)}>
                <div class="feat-cover">
                  {img ? <img src={img} alt={pl.name} loading="lazy" width="280" height="280" /> : <div />}
                </div>
                <h3>{pl.name}</h3>
                <span>{pl.description}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {playlists.map((pl) => (
      <div class="playlist-section">
        <div class="playlist-header">
          <a href={localePath(`/playlists/${pl.id}`, locale)}><h2>{pl.name}</h2></a>
          <a href={localePath(`/playlists/${pl.id}`, locale)} class="see-all">{t(locale, "playlists.seeAll")}</a>
        </div>
        <p class="playlist-desc">{pl.description}</p>
        <div class="story-row">
          {pl.stories.map((s) => (
            <a href={localePath(`/stories/${s.id}`, locale)} class="story-card">
              <div class="card-cover">
                {hasCover(s.id) ? (
                  <img src={coverUrl(s.id, 400)} alt={s.title} loading="lazy" width="180" height="180" />
                ) : (
                  <div class="card-cover-placeholder">📖</div>
                )}
                <div class="card-overlay">
                  <div class="card-ref">{s.bibleRef}</div>
                </div>
              </div>
              <div class="card-title">{s.title}</div>
              <div class="card-desc">{s.description}</div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <section class="faq-section">
      <h2>{t(locale, "playlists.faqTitle")}</h2>
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </section>

    <section class="bottom-cta">
      <h2 class="heading">{t(locale, "playlists.ctaTitle")}</h2>
      <p>{t(locale, "playlists.ctaDesc")}</p>
      <StoreButtons variant="hero" campaign={storeCampaign} />
    </section>
  </main>
</Base>

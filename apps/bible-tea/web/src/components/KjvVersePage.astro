---
import Base from "../layouts/Base.astro";
import StoreButtons from "./StoreButtons.astro";
import { getLocale, localePath, t } from "../lib/i18n";
import { kjvVerseSeo } from "../lib/seo";
import { getKjvVerseOfTheDay } from "../lib/kjv-daily";
import { getVerseOfTheDay } from "../lib/daily-verses";

const locale = getLocale(Astro.currentLocale);
const storeCampaign = locale === "es" ? "es-kjv" : "en-kjv";
const now = new Date();
const kjv = getKjvVerseOfTheDay(now);
const modern = getVerseOfTheDay(now, locale);
const today = now.toLocaleDateString(locale === "es" ? "es-ES" : "en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});
const { title, description } = kjvVerseSeo(locale, kjv, now);
const h1 = t(locale, "kjv.h1").replace("{ref}", kjv.ref);
const todayAnswer = t(locale, "kjv.todayAnswer").replace("{ref}", kjv.ref).replace("{text}", kjv.text);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "votd.breadcrumbHome"), item: locale === "es" ? "https://bibletea.app/es/" : "https://bibletea.app/" },
    { "@type": "ListItem", position: 2, name: t(locale, "kjv.breadcrumb"), item: locale === "es" ? "https://bibletea.app/es/versiculo-del-dia-kjv/" : "https://bibletea.app/kjv-verse-of-the-day/" },
  ],
};

const quoteLd = {
  "@context": "https://schema.org",
  "@type": "Quotation",
  text: kjv.text,
  isPartOf: { "@type": "CreativeWork", name: `${kjv.ref} (KJV)` },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { q: t(locale, "kjv.faqQ1"), a: t(locale, "kjv.faqA1") },
    { q: t(locale, "kjv.faqQ2"), a: t(locale, "kjv.faqA2") },
    { q: t(locale, "kjv.faqQ3"), a: t(locale, "kjv.faqA3") },
  ].map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base title={title} description={description} canonicalPath="/kjv-verse-of-the-day" esPath="/versiculo-del-dia-kjv" jsonLd={[breadcrumbLd, quoteLd, faqLd]}>
  <style>
    .bc { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); max-width: 1200px; margin: 0 auto; padding: 6.5rem 2rem 0; }
    .bc a { color: var(--text-muted); text-decoration: none; }
    .bc a:hover { color: var(--primary); }
    .bc .sep { opacity: 0.4; }
    .hero { padding: 2rem 2rem 1.25rem; text-align: center; max-width: 740px; margin: 0 auto; }
    .date { font-size: 0.85rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 1rem; }
    .hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(1.85rem, 4.5vw, 2.8rem);
      margin-bottom: 0.85rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .today-answer { color: var(--text-secondary); font-size: 1.05rem; line-height: 1.7; margin: 0; }
    .content { max-width: 1200px; margin: 0 auto; padding: 0 2rem 4rem; }
    .verse-card {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 20px;
      padding: 2.5rem 2rem;
      text-align: center;
      margin: 1.5rem 0;
    }
    .verse-label { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.1rem; }
    .verse-text { font-family: "Playfair Display", serif; font-size: clamp(1.35rem, 3vw, 1.9rem); line-height: 1.45; margin: 0 0 1rem; }
    .verse-ref { color: var(--primary); font-weight: 600; }
    .modern { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; margin: 1.5rem 0 0; }
    .about, .faq { margin: 2.5rem 0; }
    .about h2, .faq h2, .cta h2 {
      font-family: "Playfair Display", serif;
      font-size: 1.45rem;
      margin: 0 0 0.75rem;
    }
    .about p, .faq p { color: var(--text-secondary); line-height: 1.75; margin: 0 0 1rem; }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.4rem; }
    .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin: 1.5rem 0 2rem; }
    .links a {
      display: inline-flex;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: 1px solid var(--surface-border);
      background: var(--surface);
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
    }
    .links a:hover { border-color: var(--primary); color: var(--primary); }
    .cta { text-align: center; padding: 2.25rem 1.75rem; background: var(--surface); border: 1px solid var(--surface-border); border-radius: 20px; }
    .cta p { color: var(--text-secondary); margin: 0 0 1.15rem; }
    @media (max-width: 640px) {
      .bc, .hero { padding-left: 1.25rem; padding-right: 1.25rem; }
      .content { padding: 0 1.25rem 3rem; }
    }
  </style>

  <main>
    <div class="bc" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "votd.breadcrumbHome")}</a><span class="sep">/</span>
      <span>{t(locale, "kjv.breadcrumb")}</span>
    </div>
    <div class="hero">
      <p class="date">{today}</p>
      <h1>{h1}</h1>
      <p class="today-answer">{todayAnswer}</p>
    </div>

    <div class="content">
      <div class="verse-card">
        <p class="verse-label">{t(locale, "kjv.verseLabel")}</p>
        <blockquote>
          <p class="verse-text">“{kjv.text}”</p>
        </blockquote>
        <p class="verse-ref">{kjv.ref} · KJV</p>
        <p class="modern">{t(locale, "kjv.modernLabel")}: “{modern.text}” — {modern.ref}</p>
      </div>

      <div class="hero-download" style="text-align:center;margin-bottom:2rem;">
        <StoreButtons variant="hero" campaign={storeCampaign} />
      </div>

      <div class="links">
        <a href={localePath("/verse-of-the-day", locale)}>{t(locale, "kjv.linkVotd")}</a>
        <a href={localePath("/bible-app", locale)}>{t(locale, "kjv.linkApp")}</a>
        <a href={localePath("/verses/strength", locale)}>{t(locale, "kjv.linkStrength")}</a>
      </div>

      <section class="about">
        <h2>{t(locale, "kjv.aboutTitle")}</h2>
        <p>{t(locale, "kjv.aboutP1")}</p>
        <p>{t(locale, "kjv.aboutP2")}</p>
      </section>

      <section class="faq">
        <h2>{t(locale, "kjv.faqTitle")}</h2>
        <div class="faq-item"><h3>{t(locale, "kjv.faqQ1")}</h3><p>{t(locale, "kjv.faqA1")}</p></div>
        <div class="faq-item"><h3>{t(locale, "kjv.faqQ2")}</h3><p>{t(locale, "kjv.faqA2")}</p></div>
        <div class="faq-item"><h3>{t(locale, "kjv.faqQ3")}</h3><p>{t(locale, "kjv.faqA3")}</p></div>
      </section>

      <section class="cta">
        <h2>{t(locale, "kjv.ctaTitle")}</h2>
        <p>{t(locale, "kjv.ctaDesc")}</p>
        <StoreButtons variant="light" campaign={storeCampaign} />
      </section>
    </div>
  </main>
</Base>

---
import Base from "../layouts/Base.astro";
import StoreButtons from "./StoreButtons.astro";
import { getSeasons, sizedMedia } from "../lib/stories";
import { getLocale, localePath, t } from "../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const seasons = await getSeasons(locale);
const totalStories = seasons.reduce((sum, s) => sum + s.stories.length, 0);
const storeCampaign = locale === "es" ? "es-books" : "en-books";
const pageUrl = locale === "es" ? "https://bibletea.app/es/books/" : "https://bibletea.app/books/";
const homeUrl = locale === "es" ? "https://bibletea.app/es/" : "https://bibletea.app/";

const featuredSlugs = ["genesis", "exodus", "psalms", "matthew", "luke", "john", "acts", "revelation"];
const seasonMap = new Map(seasons.map((s) => [s.slug, s]));
const featured = featuredSlugs.map((slug) => seasonMap.get(slug)).filter((s): s is NonNullable<typeof s> => Boolean(s));

const title = t(locale, "books.title");
const description = t(locale, "books.description");

const faqs = [
  { q: t(locale, "books.faqQ1"), a: t(locale, "books.faqA1").replace("{count}", String(seasons.length)) },
  { q: t(locale, "books.faqQ2"), a: t(locale, "books.faqA2") },
  { q: t(locale, "books.faqQ3"), a: t(locale, "books.faqA3") },
  { q: t(locale, "books.faqQ4"), a: t(locale, "books.faqA4").replace("{stories}", String(totalStories)) },
  { q: t(locale, "books.faqQ5"), a: t(locale, "books.faqA5") },
  { q: t(locale, "books.faqQ6"), a: t(locale, "books.faqA6") },
];

function bookImg(s: (typeof seasons)[number]): string | null {
  const img = s.cover_image_url || s.stories[0]?.cover_image_url;
  return img ? sizedMedia(img, 480) : null;
}

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(locale, "books.h1"),
  description,
  url: pageUrl,
  publisher: {
    "@type": "Organization",
    name: "Bible Tea",
    logo: { "@type": "ImageObject", url: "https://bibletea.app/icon.png" },
  },
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t(locale, "books.h1"),
  numberOfItems: seasons.length,
  itemListElement: seasons.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "WebPage", name: s.name, url: `https://bibletea.app${localePath(`/books/${s.slug}`, locale)}` },
  })),
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "book.breadcrumbHome"), item: homeUrl },
    { "@type": "ListItem", position: 2, name: t(locale, "book.breadcrumbBooks"), item: pageUrl },
  ],
};
---

<Base title={title} description={description} canonicalPath="/books" jsonLd={[collectionLd, itemListLd, faqLd, breadcrumbLd]}>
  <style>
    .bc { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); max-width: 1200px; margin: 0 auto; padding: 6.5rem 2rem 0; }
    .bc a { color: var(--text-muted); text-decoration: none; }
    .bc a:hover { color: var(--primary); }
    .bc .sep { opacity: 0.4; }
    .books-hero { padding: 2rem 2rem 1.25rem; text-align: center; max-width: 760px; margin: 0 auto; }
    .books-hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .books-hero p { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin: 1.25rem 0 0; }
    .about { max-width: 760px; margin: 0 auto 2rem; padding: 0 2rem; }
    .about h2, .featured h2, .all-books h2, .faq-section h2, .bottom-cta h2 { font-family: "Playfair Display", serif; font-size: 1.5rem; margin: 0 0 0.6rem; }
    .about p { color: var(--text-secondary); line-height: 1.75; margin: 0 0 1rem; }
    .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin: 0 0 2.25rem; padding: 0 2rem; }
    .links a {
      display: inline-flex;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: 1px solid var(--surface-border);
      background: var(--surface);
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
    }
    .links a:hover { border-color: var(--primary); color: var(--primary); }
    .featured { max-width: 1200px; margin: 0 auto; padding: 0 2rem 1.5rem; }
    .featured p { color: var(--text-secondary); margin: 0 0 1.1rem; }
    .books-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
    .book-card { text-decoration: none; background: var(--surface); border: 1px solid var(--surface-border); border-radius: 16px; overflow: hidden; }
    .book-card:hover { transform: translateY(-6px); border-color: var(--primary); }
    .book-card-img { width: 100%; height: 160px; object-fit: cover; display: block; }
    .book-card-ph { width: 100%; height: 160px; background: var(--surface-light); display: flex; align-items: center; justify-content: center; font-size: 3rem; }
    .book-card-body { padding: 1.25rem; }
    .book-testament { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; color: var(--accent); margin-bottom: 0.3rem; }
    .book-card-name { font-family: "Playfair Display", serif; font-size: 1.2rem; color: var(--text); margin-bottom: 0.3rem; }
    .book-card-count { font-size: 0.8rem; color: var(--primary); font-weight: 600; margin-bottom: 0.5rem; }
    .book-card-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; }
    .all-books { max-width: 1200px; margin: 0 auto; padding: 2rem 2rem 3rem; }
    .faq-section { max-width: 700px; margin: 0 auto; padding: 1rem 2rem 3rem; }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.4rem; }
    .faq-item p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; margin: 0; }
    .bottom-cta { text-align: center; padding: 3rem 2rem 4rem; }
    .bottom-cta h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.75rem; }
    .bottom-cta p { color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 450px; margin-left: auto; margin-right: auto; }
    @media (max-width: 640px) {
      .books-hero, .about, .featured, .all-books, .faq-section { padding-left: 1.25rem; padding-right: 1.25rem; }
      .books-grid { grid-template-columns: 1fr; }
    }
  </style>

  <main>
    <div class="bc" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "book.breadcrumbHome")}</a><span class="sep">/</span>
      <span>{t(locale, "book.breadcrumbBooks")}</span>
    </div>
    <div class="books-hero">
      <h1>{t(locale, "books.h1")}</h1>
      <StoreButtons variant="hero" campaign={storeCampaign} />
      <p>{t(locale, "books.subtitle")}</p>
    </div>

    <section class="about">
      <h2>{t(locale, "books.aboutTitle")}</h2>
      <p>{t(locale, "books.aboutP1")}</p>
      <p>{t(locale, "books.aboutP2")}</p>
    </section>

    <div class="links">
      <a href={localePath("/stories", locale)}>{t(locale, "books.linkStories")}</a>
      <a href={localePath("/playlists", locale)}>{t(locale, "books.linkPlaylists")}</a>
      <a href={localePath("/bible-for-beginners", locale)}>{t(locale, "books.linkBeginners")}</a>
      <a href={localePath("/bible-app", locale)}>{t(locale, "books.linkApp")}</a>
    </div>

    {featured.length > 0 && (
      <section class="featured">
        <h2>{t(locale, "books.featuredTitle")}</h2>
        <p>{t(locale, "books.featuredSub")}</p>
        <div class="books-grid">
          {featured.map((s) => {
            const img = bookImg(s);
            return (
              <a href={localePath(`/books/${s.slug}`, locale)} class="book-card">
                {img ? (
                  <img src={img} alt={s.name} class="book-card-img" loading="lazy" width="240" height="120" />
                ) : (
                  <div class="book-card-ph">📖</div>
                )}
                <div class="book-card-body">
                  <div class="book-testament">{s.testament?.toLowerCase() === "old" ? t(locale, "books.oldTestament") : t(locale, "books.newTestament")}</div>
                  <div class="book-card-name">{s.name}</div>
                  <div class="book-card-count">{s.stories.length} {t(locale, "books.storyCount")}</div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <section class="all-books">
      <h2>{t(locale, "books.allTitle")}</h2>
      <div class="books-grid">
        {seasons.map((s) => {
          const img = bookImg(s);
          return (
            <a href={localePath(`/books/${s.slug}`, locale)} class="book-card">
              {img ? (
                <img src={img} alt={s.name} class="book-card-img" loading="lazy" width="240" height="120" />
              ) : (
                <div class="book-card-ph">📖</div>
              )}
              <div class="book-card-body">
                <div class="book-testament">{s.testament?.toLowerCase() === "old" ? t(locale, "books.oldTestament") : t(locale, "books.newTestament")}</div>
                <div class="book-card-name">{s.name}</div>
                <div class="book-card-count">{s.stories.length} {t(locale, "books.storyCount")}</div>
                {s.description && <div class="book-card-desc">{s.description}</div>}
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="faq-section">
      <h2>{t(locale, "books.faqTitle")}</h2>
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </section>

    <section class="bottom-cta">
      <h2>{t(locale, "books.ctaTitle")}</h2>
      <p>{t(locale, "books.ctaDesc")}</p>
      <StoreButtons variant="hero" campaign={storeCampaign} />
    </section>
  </main>
</Base>

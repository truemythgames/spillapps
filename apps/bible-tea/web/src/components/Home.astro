        <li>{t(locale, "home.offer2")}</li>
        <li>{t(locale, "home.offer3")}</li>
      </ul>
      <StoreButtons variant="hero" campaign={homeCampaign} />
    </div>
  </section>

  <section class="home-faq">
    <h2 class="heading section-title">{t(locale, "home.faqTitle")}</h2>
    {faqs.map((f) => (
      <details class="faq-item">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section class="cta-section">
    <div class="cta-inner">
      <img src="/icon-sm.webp" alt={iconAlt} class="cta-icon" width="76" height="76" loading="lazy" decoding="async" />
      <h2 class="heading">{t(locale, "home.ctaTitle")}</h2>
      <p>{t(locale, "home.ctaSub")}</p>
      <StoreButtons variant="light" campaign={homeCampaign} />
    </div>
  </section>

  <div id="sticky-cta" class="sticky-cta" hidden inert>
    <img src="/icon-sm.webp" alt="" width="40" height="40" loading="lazy" decoding="async" />
    <div class="sticky-meta">
      <div class="sticky-name">Bible Tea</div>
      <div class="sticky-tag">{t(locale, "home.stickyTag")}</div>
    </div>
    <a href={homeApple} class="sticky-btn nav-store-apple" aria-label={t(locale, "nav.appStore")}>{t(locale, "home.stickyCta")}</a>
    <a href={homePlay} class="sticky-btn nav-store-play" aria-label={t(locale, "nav.googlePlay")}>{t(locale, "home.stickyCta")}</a>
  </div>

  <script is:inline>
    (function () {
      var io = 'IntersectionObserver' in window;

      var hero = document.querySelector('.hero');
      var bar = document.getElementById('sticky-cta');
      if (hero && bar) {
        var compact = window.matchMedia('(max-width: 720px)');
        var pastHero = false;
        var setBarShown = function (show) {
          bar.classList.toggle('visible', show);
          bar.toggleAttribute('hidden', !show);
          bar.toggleAttribute('inert', !show);
        };
        var syncBar = function () { setBarShown(compact.matches && pastHero); };
        if (io) {
          new IntersectionObserver(function (entries) {
            pastHero = !entries[0].isIntersecting;
            syncBar();
          }).observe(hero);
        }
        if (typeof compact.addEventListener === 'function') {
          compact.addEventListener('change', syncBar);
        } else if (typeof compact.addListener === 'function') {
          compact.addListener(syncBar);
        }
        syncBar();
      }

      var motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Fade sections in as they scroll into view. Staggered per group so grids
      // cascade instead of all landing at once.
      if (io && motion) {
        var revealed = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            var siblings = Array.prototype.slice.call(el.parentNode.children);
            el.style.transitionDelay = Math.min(siblings.indexOf(el), 5) * 70 + 'ms';
            el.classList.add('in');
            revealed.unobserve(el);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(function (el) { revealed.observe(el); });
      }

      // Count the numeric stats up the first time they appear.
      if (io && motion) {
        var counters = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            counters.unobserve(el);
            var raw = el.getAttribute('data-value') || '';
            var match = raw.match(/^(\d+)(.*)$/);
            if (!match) return;
            var target = parseInt(match[1], 10);
            var suffix = match[2];
            var start = performance.now();
            (function step(now) {
              var p = Math.min((now - start) / 900, 1);
              var eased = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(target * eased) + suffix;
              if (p < 1) requestAnimationFrame(step);
            })(start);
          });
        }, { threshold: 0.5 });
        document.querySelectorAll('.stat-value').forEach(function (el) { counters.observe(el); });
      }

      // Same pixels-per-second on every strip so the long cover row
      // does not race the short name ticker.
      if (motion) {
        var marquees = document.querySelectorAll('.trust-track, .card-scroll, .card-scroll-reverse');
        var syncMarquees = function () {
          marquees.forEach(function (el) {
            var distance = el.scrollWidth / 2;
            if (distance < 10) return;
            el.style.setProperty('--marquee-duration', (distance / 40) + 's');
          });
        };
        syncMarquees();
        window.addEventListener('load', syncMarquees);
        if (window.ResizeObserver) {
          var ro = new ResizeObserver(syncMarquees);
          marquees.forEach(function (el) { ro.observe(el); });
        }
      }

    })();
  </script>
</Base>

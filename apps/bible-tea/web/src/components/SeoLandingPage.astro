---
import Base from "../layouts/Base.astro";
import StoreButtons from "./StoreButtons.astro";
import CoverImg from "./CoverImg.astro";
import { getLocale, localePath, t } from "../lib/i18n";
import { getLanding, type LandingId } from "../lib/landing-copy";
import { getCatalog, hasCover } from "../lib/stories";
import { clampTitle, clampDescription } from "../lib/seo";

interface Props {
  id: LandingId;
}

const { id } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const landing = getLanding(id, locale);
const catalog = getCatalog(locale);
const catalogMap = new Map(catalog.map((s) => [s.id, s]));
const stories = landing.featuredIds
  .map((storyId) => catalogMap.get(storyId))
  .filter((s): s is NonNullable<typeof s> => Boolean(s && hasCover(s.id)));

const pageUrl = locale === "es"
  ? `https://bibletea.app/es${landing.esPath}/`
  : `https://bibletea.app${landing.canonicalPath}/`;

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "votd.breadcrumbHome"), item: locale === "es" ? "https://bibletea.app/es/" : "https://bibletea.app/" },
    { "@type": "ListItem", position: 2, name: landing.breadcrumb, item: pageUrl },
  ],
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: landing.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const title = clampTitle(landing.title);
const description = clampDescription(landing.description);
---

<Base title={title} description={description} canonicalPath={landing.canonicalPath} esPath={landing.esPath} jsonLd={[breadcrumbLd, faqLd]}>
  <style>
    .bc { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); max-width: 1200px; margin: 0 auto; padding: 6.5rem 2rem 0; }
    .bc a { color: var(--text-muted); text-decoration: none; }
    .bc a:hover { color: var(--primary); }
    .bc .sep { opacity: 0.4; }
    .hero { padding: 2rem 2rem 1.5rem; text-align: center; max-width: 760px; margin: 0 auto; }
    .hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(2rem, 5vw, 3.1rem);
      margin-bottom: 0.85rem;
      color: var(--text);
    }
    .hero p { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1.5rem; }
    .content { max-width: 1200px; margin: 0 auto; padding: 0 2rem 4rem; }
    .stories-head, .mid-cta h2, .final-cta h2, .about h2, .faq h2, .compare h2 {
      font-family: "Playfair Display", serif;
      font-size: 1.5rem;
      margin: 0 0 0.45rem;
    }
    .stories-head { text-align: center; margin: 1rem 0 1.25rem; }
    .stories-head p { color: var(--text-secondary); margin: 0; }
    .story-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.85rem; margin-bottom: 1.25rem; }
    .story-card { text-decoration: none; color: inherit; }
    .story-card :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 14px; display: block; }
    .story-card h3 { font-size: 0.92rem; margin: 0.55rem 0 0.15rem; }
    .story-card span { color: var(--text-muted); font-size: 0.78rem; }
    .mid-cta, .final-cta {
      text-align: center;
      padding: 2.25rem 1.75rem;
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 20px;
      margin: 2rem 0;
    }
    .mid-cta p, .final-cta p, .about p, .faq p, .disclaimer { color: var(--text-secondary); line-height: 1.75; margin: 0 0 1.1rem; }
    .about { margin: 2.25rem 0; }
    .compare { margin: 2.25rem 0; overflow-x: auto; }
    .compare table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .compare th, .compare td { text-align: left; padding: 0.75rem 0.85rem; border-bottom: 1px solid var(--surface-border); vertical-align: top; }
    .compare th { color: var(--text); font-weight: 700; }
    .compare td { color: var(--text-secondary); }
    .compare td:first-child { color: var(--text); font-weight: 600; width: 22%; }
    .faq { margin: 2.25rem 0 1rem; }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.4rem; }
    .disclaimer { font-size: 0.82rem; }
    .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin: 0 0 2rem; }
    .links a {
      display: inline-flex;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: 1px solid var(--surface-border);
      background: var(--surface);
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
    }
    .links a:hover { border-color: var(--primary); color: var(--primary); }
    @media (max-width: 900px) {
      .story-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      .story-grid { grid-template-columns: 1fr; }
      .bc, .hero { padding-left: 1.25rem; padding-right: 1.25rem; }
      .content { padding: 0 1.25rem 3rem; }
    }
  </style>

  <main>
    <div class="bc" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "votd.breadcrumbHome")}</a><span class="sep">/</span>
      <span>{landing.breadcrumb}</span>
    </div>
    <div class="hero">
      <h1>{landing.h1}</h1>
      <p>{landing.subtitle}</p>
      <StoreButtons variant="hero" campaign={landing.campaign} />
    </div>

    <div class="content">
      <div class="stories-head">
        <h2>{landing.storiesTitle}</h2>
        <p>{landing.storiesSub}</p>
      </div>
      <div class="story-grid">
        {stories.map((story) => (
          <a class="story-card" href={localePath(`/stories/${story.id}`, locale)}>
            <CoverImg storyId={story.id} alt={story.title} width={280} height={280} />
            <h3>{story.title}</h3>
            <span>{story.bibleRef}</span>
          </a>
        ))}
      </div>

      <section class="mid-cta">
        <h2>{landing.midTitle}</h2>
        <p>{landing.midDesc}</p>
        <StoreButtons variant="light" campaign={landing.campaign} />
      </section>

      {landing.compare && (
        <section class="compare">
          <h2>{landing.compare.title}</h2>
          <table>
            <thead>
              <tr>
                <th></th>
                <th>Bible Tea</th>
                <th>{landing.compare.them}</th>
              </tr>
            </thead>
            <tbody>
              {landing.compare.rows.map((row) => (
                <tr>
                  <td>{row.label}</td>
                  <td>{row.tea}</td>
                  <td>{row.them}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}

      <section class="about">
        <h2>{landing.aboutTitle}</h2>
        {landing.about.map((p) => <p>{p}</p>)}
        {landing.disclaimer && <p class="disclaimer">{landing.disclaimer}</p>}
      </section>

      <div class="links">
        <a href={localePath("/bible-app", locale)}>{landing.linkApp}</a>
        <a href={localePath("/stories", locale)}>{landing.linkStories}</a>
        <a href={localePath("/bible-stories-for-sleep", locale)}>{landing.linkSleep}</a>
      </div>

      <section class="faq">
        <h2>{landing.faqTitle}</h2>
        {landing.faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>

      <section class="final-cta">
        <h2>{landing.finalTitle}</h2>
        <p>{landing.finalDesc}</p>
        <StoreButtons variant="light" campaign={landing.campaign} />
      </section>
    </div>
  </main>
</Base>

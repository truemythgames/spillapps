---
import Base from "../layouts/Base.astro";
import StoreButtons from "./StoreButtons.astro";
import { getCharacters, sizedMedia } from "../lib/stories";
import { getLocale, localePath, t } from "../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const characters = await getCharacters(locale);
const storeCampaign = locale === "es" ? "es-characters" : "en-characters";
const pageUrl = locale === "es" ? "https://bibletea.app/es/characters/" : "https://bibletea.app/characters/";
const homeUrl = locale === "es" ? "https://bibletea.app/es/" : "https://bibletea.app/";
const count = String(characters.length);

const featuredIds = ["ch-jesus", "ch-david", "ch-moses", "ch-abraham", "ch-paul", "ch-mary", "ch-esther", "ch-ruth"];
const charMap = new Map(characters.map((c) => [c.id, c]));
const featured = featuredIds.map((id) => charMap.get(id)).filter((c): c is NonNullable<typeof c> => Boolean(c));

const title = t(locale, "characters.title");
const description = t(locale, "characters.description");

const faqs = [
  { q: t(locale, "characters.faqQ1"), a: t(locale, "characters.faqA1").replace("{count}", count) },
  { q: t(locale, "characters.faqQ2"), a: t(locale, "characters.faqA2") },
  { q: t(locale, "characters.faqQ3"), a: t(locale, "characters.faqA3").replace("{count}", count) },
  { q: t(locale, "characters.faqQ4"), a: t(locale, "characters.faqA4") },
  { q: t(locale, "characters.faqQ5"), a: t(locale, "characters.faqA5") },
  { q: t(locale, "characters.faqQ6"), a: t(locale, "characters.faqA6") },
];

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(locale, "characters.h1"),
  description,
  url: pageUrl,
  publisher: {
    "@type": "Organization",
    name: "Bible Tea",
    logo: { "@type": "ImageObject", url: "https://bibletea.app/icon.png" },
  },
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t(locale, "characters.h1"),
  numberOfItems: characters.length,
  itemListElement: characters.map((ch, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "WebPage", name: ch.name, url: `https://bibletea.app${localePath(`/characters/${ch.id}`, locale)}` },
  })),
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "character.breadcrumbHome"), item: homeUrl },
    { "@type": "ListItem", position: 2, name: t(locale, "character.breadcrumbCharacters"), item: pageUrl },
  ],
};
---

<Base title={title} description={description} canonicalPath="/characters" jsonLd={[collectionLd, itemListLd, faqLd, breadcrumbLd]}>
  <style>
    .bc { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); max-width: 1200px; margin: 0 auto; padding: 6.5rem 2rem 0; }
    .bc a { color: var(--text-muted); text-decoration: none; }
    .bc a:hover { color: var(--primary); }
    .bc .sep { opacity: 0.4; }
    .characters-hero { padding: 2rem 2rem 1.25rem; text-align: center; max-width: 760px; margin: 0 auto; }
    .characters-hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .characters-hero p { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin: 1.25rem 0 0; }
    .about { max-width: 760px; margin: 0 auto 2rem; padding: 0 2rem; }
    .about h2, .featured h2, .all-chars h2, .faq-section h2, .bottom-cta h2 { font-family: "Playfair Display", serif; font-size: 1.5rem; margin: 0 0 0.6rem; }
    .about p { color: var(--text-secondary); line-height: 1.75; margin: 0 0 1rem; }
    .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin: 0 0 2.25rem; padding: 0 2rem; }
    .links a {
      display: inline-flex;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: 1px solid var(--surface-border);
      background: var(--surface);
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
    }
    .links a:hover { border-color: var(--primary); color: var(--primary); }
    .featured { max-width: 1200px; margin: 0 auto; padding: 0 2rem 1.5rem; }
    .featured p { color: var(--text-secondary); margin: 0 0 1.1rem; }
    .feat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
    .char-card { text-decoration: none; text-align: center; }
    .char-card:hover { transform: translateY(-6px); }
    .char-avatar { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto 0.75rem; box-shadow: 0 8px 28px rgba(0, 0, 0, 0.4); border: 3px solid var(--surface-border); display: block; }
    .char-card:hover .char-avatar { border-color: var(--primary); }
    .char-avatar-ph { width: 120px; height: 120px; border-radius: 50%; margin: 0 auto 0.75rem; background: var(--surface-light); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; border: 3px solid var(--surface-border); }
    .char-name { font-family: "Playfair Display", serif; font-size: 1rem; color: var(--text); margin-bottom: 0.2rem; }
    .char-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.3; }
    .char-count { font-size: 0.7rem; color: var(--accent); font-weight: 600; margin-top: 0.15rem; }
    .all-chars { max-width: 1200px; margin: 0 auto; padding: 2rem 2rem 3rem; }
    .characters-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 2rem; }
    .faq-section { max-width: 700px; margin: 0 auto; padding: 1rem 2rem 3rem; }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.4rem; }
    .faq-item p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; margin: 0; }
    .bottom-cta { text-align: center; padding: 3rem 2rem 4rem; }
    .bottom-cta h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.75rem; }
    .bottom-cta p { color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 450px; margin-left: auto; margin-right: auto; }
    @media (max-width: 900px) { .feat-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 640px) {
      .characters-hero, .about, .featured, .all-chars, .faq-section { padding-left: 1.25rem; padding-right: 1.25rem; }
      .feat-grid, .characters-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
      .char-avatar, .char-avatar-ph { width: 100px; height: 100px; }
    }
  </style>

  <main>
    <div class="bc" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "character.breadcrumbHome")}</a><span class="sep">/</span>
      <span>{t(locale, "character.breadcrumbCharacters")}</span>
    </div>
    <div class="characters-hero">
      <h1>{t(locale, "characters.h1")}</h1>
      <StoreButtons variant="hero" campaign={storeCampaign} />
      <p>{t(locale, "characters.subtitle")}</p>
    </div>

    <section class="about">
      <h2>{t(locale, "characters.aboutTitle")}</h2>
      <p>{t(locale, "characters.aboutP1")}</p>
      <p>{t(locale, "characters.aboutP2")}</p>
    </section>

    <div class="links">
      <a href={localePath("/stories", locale)}>{t(locale, "characters.linkStories")}</a>
      <a href={localePath("/playlists", locale)}>{t(locale, "characters.linkPlaylists")}</a>
      <a href={localePath("/verse-of-the-day", locale)}>{t(locale, "characters.linkVerse")}</a>
      <a href={localePath("/bible-app", locale)}>{t(locale, "characters.linkApp")}</a>
    </div>

    {featured.length > 0 && (
      <section class="featured">
        <h2>{t(locale, "characters.featuredTitle")}</h2>
        <p>{t(locale, "characters.featuredSub")}</p>
        <div class="feat-grid">
          {featured.map((ch) => (
            <a href={localePath(`/characters/${ch.id}`, locale)} class="char-card">
              {ch.image_url ? (
                <img src={sizedMedia(ch.image_url, 240)} alt={ch.name} class="char-avatar" loading="lazy" width="120" height="120" />
              ) : (
                <div class="char-avatar-ph">👤</div>
              )}
              <div class="char-name">{ch.name}</div>
              <div class="char-desc">{ch.description}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="all-chars">
      <h2>{t(locale, "characters.allTitle")}</h2>
      <div class="characters-grid">
        {characters.map((ch) => (
          <a href={localePath(`/characters/${ch.id}`, locale)} class="char-card">
            {ch.image_url ? (
              <img src={sizedMedia(ch.image_url, 240)} alt={ch.name} class="char-avatar" loading="lazy" width="120" height="120" />
            ) : (
              <div class="char-avatar-ph">👤</div>
            )}
            <div class="char-name">{ch.name}</div>
            <div class="char-desc">{ch.description}</div>
            {ch.stories.length > 0 && (
              <div class="char-count">{ch.stories.length} {t(locale, "characters.storyCount")}</div>
            )}
          </a>
        ))}
      </div>
    </section>

    <section class="faq-section">
      <h2>{t(locale, "characters.faqTitle")}</h2>
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </section>

    <section class="bottom-cta">
      <h2>{t(locale, "characters.ctaTitle")}</h2>
      <p>{t(locale, "characters.ctaDesc")}</p>
      <StoreButtons variant="hero" campaign={storeCampaign} />
    </section>
  </main>
</Base>

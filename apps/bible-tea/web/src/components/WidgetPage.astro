---
import Base from "../layouts/Base.astro";
import StoreButtons from "./StoreButtons.astro";
import { getLocale, localePath, t } from "../lib/i18n";
import { clampTitle, clampDescription } from "../lib/seo";

const locale = getLocale(Astro.currentLocale);
const title = clampTitle(t(locale, "widget.title"));
const description = clampDescription(t(locale, "widget.description"));
const storeCampaign = locale === "es" ? "es-widget" : "en-widget";
const pageUrl = locale === "es" ? "https://bibletea.app/es/widget/" : "https://bibletea.app/widget/";
const homeUrl = locale === "es" ? "https://bibletea.app/es/" : "https://bibletea.app/";

const faqs = [
  { q: t(locale, "widget.faqQ1"), a: t(locale, "widget.faqA1") },
  { q: t(locale, "widget.faqQ2"), a: t(locale, "widget.faqA2") },
  { q: t(locale, "widget.faqQ3"), a: t(locale, "widget.faqA3") },
  { q: t(locale, "widget.faqQ4"), a: t(locale, "widget.faqA4") },
  { q: t(locale, "widget.faqQ5"), a: t(locale, "widget.faqA5") },
  { q: t(locale, "widget.faqQ6"), a: t(locale, "widget.faqA6") },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "votd.breadcrumbHome"), item: homeUrl },
    { "@type": "ListItem", position: 2, name: t(locale, "widget.breadcrumbWidget"), item: pageUrl },
  ],
};

const appLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Bible Tea",
  operatingSystem: "iOS, Android",
  applicationCategory: "ReligionApplication",
  url: "https://bibletea.app/",
  image: "https://bibletea.app/icon.png",
  description,
  aggregateRating: { "@type": "AggregateRating", ratingValue: "5", ratingCount: "50", bestRating: "5" },
  featureList: "Bible Verse Widget, Daily Bible Verse, Lock Screen Widget, Home Screen Widget, Bible Stories Audio",
};

const howToLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: t(locale, "widget.howTitle"),
  description: t(locale, "widget.subtitle"),
  step: [
    { "@type": "HowToStep", position: 1, name: t(locale, "widget.step1"), text: t(locale, "widget.step1Desc") },
    { "@type": "HowToStep", position: 2, name: t(locale, "widget.step2"), text: t(locale, "widget.step2Desc") },
    { "@type": "HowToStep", position: 3, name: t(locale, "widget.step3"), text: t(locale, "widget.step3Desc") },
  ],
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: pageUrl,
  isPartOf: { "@type": "WebSite", name: "Bible Tea", url: "https://bibletea.app/" },
  about: { "@type": "Thing", name: t(locale, "widget.h1") },
};
---

<Base title={title} description={description} canonicalPath="/widget" jsonLd={[breadcrumbLd, appLd, howToLd, faqLd, webPageLd]}>
  <style>
    .bc { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); max-width: 1200px; margin: 0 auto; padding: 6.5rem 2rem 0; }
    .bc a { color: var(--text-muted); text-decoration: none; }
    .bc a:hover { color: var(--primary); }
    .bc .sep { opacity: 0.4; }
    .widget-hero { padding: 2rem 2rem 1.25rem; text-align: center; max-width: 760px; margin: 0 auto; }
    .widget-hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .widget-hero p { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin: 1.25rem 0 0; }
    .about { max-width: 760px; margin: 0 auto 2rem; padding: 0 2rem; }
    .about h2, .how-section h2, .features h2, .more-section h2, .faq-section h2, .bottom-cta h2 { font-family: "Playfair Display", serif; font-size: 1.5rem; margin: 0 0 0.6rem; }
    .about p { color: var(--text-secondary); line-height: 1.75; margin: 0 0 1rem; }
    .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin: 0 0 2.25rem; padding: 0 2rem; }
    .links a {
      display: inline-flex;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: 1px solid var(--surface-border);
      background: var(--surface);
      color: var(--text);
      font-weight: 600;
      font-size: 0.92rem;
      text-decoration: none;
    }
    .links a:hover { border-color: var(--primary); color: var(--primary); }
    .widget-content { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
    .how-section { margin-bottom: 3rem; }
    .steps { display: flex; flex-direction: column; gap: 1.25rem; }
    .step { display: flex; gap: 1.5rem; align-items: flex-start; background: var(--surface); border: 1px solid var(--surface-border); border-radius: 16px; padding: 1.5rem; }
    .step:hover { border-color: var(--primary); }
    .step-num {
      width: 40px; height: 40px; border-radius: 50%;
      background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
      color: #fff; display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 1.1rem; flex-shrink: 0;
    }
    .step-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 0.35rem; }
    .step-desc { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; }
    .cta-mid { text-align: center; margin-bottom: 3rem; }
    .cta-mid p { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1rem; }
    .features { margin-bottom: 3rem; }
    .features-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem; }
    .feature-card { background: var(--surface); border: 1px solid var(--surface-border); border-radius: 16px; padding: 1.5rem; }
    .feature-card:hover { transform: translateY(-4px); border-color: var(--primary); }
    .feature-card h3 { font-family: "Playfair Display", serif; font-size: 1.05rem; margin-bottom: 0.4rem; }
    .feature-card p { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; }
    .more-section {
      text-align: center; padding: 2.5rem;
      background: linear-gradient(135deg, rgba(200, 162, 255, 0.08) 0%, rgba(107, 92, 231, 0.08) 100%);
      border: 1px solid rgba(200, 162, 255, 0.2); border-radius: 20px; margin-bottom: 3rem;
    }
    .more-section p { color: var(--text-secondary); font-size: 1rem; line-height: 1.7; max-width: 520px; margin: 0 auto 1rem; }
    .faq-section { max-width: 700px; margin: 0 auto; padding: 1rem 2rem 3rem; }
    .faq-item { margin-bottom: 1.25rem; }
    .faq-item h3 { font-size: 1rem; margin: 0 0 0.4rem; }
    .faq-item p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; margin: 0; }
    .bottom-cta { text-align: center; padding: 3rem 2rem 4rem; }
    .bottom-cta h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.75rem; }
    .bottom-cta p { color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 450px; margin-left: auto; margin-right: auto; }
    @media (max-width: 640px) {
      .widget-hero, .about, .widget-content, .faq-section { padding-left: 1.25rem; padding-right: 1.25rem; }
      .features-grid { grid-template-columns: 1fr; }
      .step { flex-direction: column; gap: 1rem; text-align: center; }
    }
  </style>

  <main>
    <div class="bc" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "votd.breadcrumbHome")}</a>
      <span class="sep">/</span>
      <span>{t(locale, "widget.breadcrumbWidget")}</span>
    </div>

    <div class="widget-hero">
      <h1>{t(locale, "widget.h1")}</h1>
      <StoreButtons variant="hero" campaign={storeCampaign} />
      <p>{t(locale, "widget.subtitle")}</p>
    </div>

    <section class="about">
      <h2>{t(locale, "widget.aboutTitle")}</h2>
      <p>{t(locale, "widget.aboutP1")}</p>
      <p>{t(locale, "widget.aboutP2")}</p>
    </section>

    <div class="links">
      <a href={localePath("/verse-of-the-day", locale)}>{t(locale, "nav.verseOfTheDay")}</a>
      <a href={localePath("/stories", locale)}>{t(locale, "widget.linkStories")}</a>
      <a href={localePath("/prayers", locale)}>{t(locale, "widget.linkPrayers")}</a>
      <a href={localePath("/bible-app", locale)}>{t(locale, "widget.linkApp")}</a>
    </div>

    <div class="widget-content">
      <section class="how-section">
        <h2>{t(locale, "widget.howTitle")}</h2>
        <div class="steps">
          <div class="step">
            <div class="step-num">1</div>
            <div>
              <div class="step-title">{t(locale, "widget.step1")}</div>
              <p class="step-desc">{t(locale, "widget.step1Desc")}</p>
            </div>
          </div>
          <div class="step">
            <div class="step-num">2</div>
            <div>
              <div class="step-title">{t(locale, "widget.step2")}</div>
              <p class="step-desc">{t(locale, "widget.step2Desc")}</p>
            </div>
          </div>
          <div class="step">
            <div class="step-num">3</div>
            <div>
              <div class="step-title">{t(locale, "widget.step3")}</div>
              <p class="step-desc">{t(locale, "widget.step3Desc")}</p>
            </div>
          </div>
        </div>
      </section>

      <div class="cta-mid">
        <p>{t(locale, "widget.ctaDesc")}</p>
        <StoreButtons variant="hero" campaign={storeCampaign} />
      </div>

      <section class="features">
        <h2>{t(locale, "widget.featureTitle")}</h2>
        <div class="features-grid">
          <div class="feature-card"><h3>{t(locale, "widget.featureF1")}</h3><p>{t(locale, "widget.featureF1Desc")}</p></div>
          <div class="feature-card"><h3>{t(locale, "widget.featureF2")}</h3><p>{t(locale, "widget.featureF2Desc")}</p></div>
          <div class="feature-card"><h3>{t(locale, "widget.featureF3")}</h3><p>{t(locale, "widget.featureF3Desc")}</p></div>
          <div class="feature-card"><h3>{t(locale, "widget.featureF4")}</h3><p>{t(locale, "widget.featureF4Desc")}</p></div>
        </div>
      </section>

      <section class="more-section">
        <h2>{t(locale, "widget.moreTitle")}</h2>
        <p>{t(locale, "widget.moreDesc")}</p>
      </section>
    </div>

    <section class="faq-section">
      <h2>{t(locale, "widget.faqTitle")}</h2>
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </section>

    <section class="bottom-cta">
      <h2>{t(locale, "widget.ctaTitle")}</h2>
      <p>{t(locale, "widget.ctaDesc")}</p>
      <StoreButtons variant="hero" campaign={storeCampaign} />
    </section>
  </main>
</Base>

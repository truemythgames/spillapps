---
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import StoreButtons from "../../components/StoreButtons.astro";
import { getPrayers, getPrayerDetail, prayerBody, type PrayerDetail, type Prayer } from "../../lib/stories";
import { getLocale, localePath, t } from "../../lib/i18n";

export async function getStaticPaths() {
  const prayers = await getPrayers("en");
  const details = await Promise.all(prayers.map((p) => getPrayerDetail(p.slug, "en")));
  return prayers.map((p, i) => ({
    params: { slug: p.slug },
    props: { detail: details[i] ?? { ...p, related_stories: [], related_characters: [] }, allPrayers: prayers },
  }));
}

interface Props {
  detail: PrayerDetail;
  allPrayers: Prayer[];
}

const { detail, allPrayers } = Astro.props;
const locale = getLocale(Astro.currentLocale);

const bodyHtml = await marked.parse(prayerBody(detail.transcript));

const pageTitle = t(locale, "prayer.pageTitle").replace(/\{title\}/g, detail.title);
const pageDesc = t(locale, "prayer.pageDesc").replace(/\{description\}/g, detail.description);
const pageUrl = `https://bibletea.app/prayers/${detail.slug}/`;

const creativeWorkLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: detail.title,
  description: detail.description,
  url: pageUrl,
  genre: "Prayer",
  about: detail.category_name,
  publisher: {
    "@type": "Organization",
    name: "Bible Tea",
    logo: { "@type": "ImageObject", url: "https://bibletea.app/icon.png" },
  },
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://bibletea.app" },
    { "@type": "ListItem", position: 2, name: "Prayers", item: "https://bibletea.app/prayers" },
    { "@type": "ListItem", position: 3, name: detail.title, item: pageUrl },
  ],
};

function faqT(key: string): string {
  return t(locale, key as any)
    .replace(/\{title\}/g, detail.title)
    .replace(/\{description\}/g, detail.description);
}
const faqs = [
  { q: faqT("prayer.faqQ1"), a: faqT("prayer.faqA1") },
  { q: faqT("prayer.faqQ2"), a: faqT("prayer.faqA2") },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const jsonLdArray = [creativeWorkLd, breadcrumbLd, faqLd];

const morePrayers = allPrayers.filter((p) => p.slug !== detail.slug).slice(0, 8);
---

<Base title={pageTitle} description={pageDesc} canonicalPath={`/prayers/${detail.slug}`} jsonLd={jsonLdArray}>
  <style>
    .prayer-page { max-width: 760px; margin: 0 auto; padding: 7rem 2rem 0; }

    .breadcrumbs { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 2rem; flex-wrap: wrap; }
    .breadcrumbs a { color: var(--text-muted); text-decoration: none; transition: color 0.2s; }
    .breadcrumbs a:hover { color: var(--primary); }
    .breadcrumbs .sep { opacity: 0.4; }

    .prayer-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 600; color: var(--accent); margin-bottom: 0.5rem; }
    .prayer-h1 { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem, 4.5vw, 2.6rem); line-height: 1.15; margin-bottom: 0.6rem; }
    .prayer-cat-link { display: inline-block; font-size: 0.85rem; color: var(--primary); text-decoration: none; margin-bottom: 1.25rem; }
    .prayer-cat-link:hover { text-decoration: underline; }
    .prayer-lead { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem; }

    .prayer-body {
      background: var(--surface); border: 1px solid var(--surface-border); border-left: 3px solid var(--primary);
      border-radius: 14px; padding: 1.75rem 1.9rem; margin-bottom: 2.5rem;
    }
    .prayer-body :global(p) { color: var(--text); font-size: 1.08rem; line-height: 1.9; margin-bottom: 1.1rem; }
    .prayer-body :global(p:last-child) { margin-bottom: 0; }

    .cta-inline { margin-bottom: 3rem; }

    .related { margin-bottom: 2.5rem; }
    .related h2 { font-family: 'Playfair Display', serif; font-size: 1.3rem; margin-bottom: 1rem; }

    .stories-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1.25rem; }
    .story-card { text-decoration: none; transition: transform 0.25s; }
    .story-card:hover { transform: translateY(-6px) scale(1.02); }
    .card-cover { width: 100%; aspect-ratio: 1; border-radius: 14px; overflow: hidden; position: relative; margin-bottom: 0.6rem; box-shadow: 0 8px 24px rgba(0,0,0,0.35); }
    .card-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .card-cover-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--surface) 0%, var(--surface-light) 100%); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
    .card-title { font-family: 'Playfair Display', serif; font-size: 0.9rem; font-weight: 700; color: var(--text); line-height: 1.25; }

    .char-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .char-chip {
      display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;
      background: var(--surface); border: 1px solid var(--surface-border); border-radius: 999px;
      padding: 0.5rem 1rem 0.5rem 0.6rem; transition: border-color 0.2s, transform 0.2s;
    }
    .char-chip:hover { border-color: var(--primary); transform: translateY(-2px); }
    .char-chip-emoji { width: 28px; height: 28px; border-radius: 50%; background: var(--surface-light); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; }
    .char-chip-name { font-size: 0.9rem; font-weight: 600; color: var(--text); }

    .faq-section { padding: 3rem 0; border-top: 1px solid var(--surface-border); }
    .faq-section h2 { font-family: 'Playfair Display', serif; font-size: 1.35rem; margin-bottom: 1rem; }
    .faq-item { background: var(--surface); border: 1px solid var(--surface-border); border-radius: 12px; margin-bottom: 0.6rem; overflow: hidden; transition: border-color 0.2s; }
    .faq-item:hover { border-color: var(--primary); }
    .faq-item[open] { border-color: rgba(200, 162, 255, 0.3); }
    .faq-item summary { padding: 1rem 1.25rem; cursor: pointer; font-weight: 600; font-size: 0.95rem; color: var(--text); list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: '+'; font-size: 1.25rem; color: var(--primary); flex-shrink: 0; }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 1.25rem 1rem; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.7; }

    .more-prayers { max-width: 1100px; margin: 0 auto; padding: 3rem 2rem; border-top: 1px solid var(--surface-border); }
    .more-prayers h2 { font-family: 'Playfair Display', serif; font-size: 1.35rem; margin-bottom: 1.25rem; }
    .more-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
    .more-card { display: block; text-decoration: none; background: var(--surface); border: 1px solid var(--surface-border); border-radius: 14px; padding: 1.1rem 1.25rem; transition: transform 0.2s, border-color 0.2s; }
    .more-card:hover { transform: translateY(-4px); border-color: var(--primary); }
    .more-card-title { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: var(--text); line-height: 1.3; margin-bottom: 0.3rem; }
    .more-card-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .bottom-cta { text-align: center; padding: 4rem 2rem 3rem; }
    .bottom-cta h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.75rem; }
    .bottom-cta p { color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 480px; margin-left: auto; margin-right: auto; }

    @media (max-width: 640px) {
      .prayer-page { padding: 6rem 1.5rem 0; }
      .prayer-body { padding: 1.35rem 1.4rem; }
      .more-prayers { padding: 2rem 1.5rem; }
    }
  </style>

  <main>
    <div class="prayer-page">
      <div class="breadcrumbs">
        <a href={localePath("/", locale)}>{t(locale, "prayer.breadcrumbHome")}</a>
        <span class="sep">/</span>
        <a href={localePath("/prayers", locale)}>{t(locale, "prayer.breadcrumbPrayers")}</a>
        <span class="sep">/</span>
        <span>{detail.title}</span>
      </div>

      <div class="prayer-label">{t(locale, "prayer.label")}</div>
      <h1 class="prayer-h1">{detail.title}</h1>
      {detail.category_name && (
        <a href={localePath("/prayers", locale)} class="prayer-cat-link">{detail.category_name}</a>
      )}
      {detail.description && <p class="prayer-lead">{detail.description}</p>}

      <div class="prayer-body">
        <Fragment set:html={bodyHtml} />
      </div>

      <div class="cta-inline">
        <StoreButtons variant="hero" />
      </div>

      {detail.related_stories.length > 0 && (
        <section class="related">
          <h2>{t(locale, "prayer.relatedStories")}</h2>
          <div class="stories-grid">
            {detail.related_stories.map((s) => (
              <a href={localePath(`/stories/${s.slug}`, locale)} class="story-card">
                <div class="card-cover">
                  {s.cover_image_url ? (
                    <img src={s.cover_image_url} alt={s.title} loading="lazy" width="300" height="300" />
                  ) : (
                    <div class="card-cover-placeholder">📖</div>
                  )}
                </div>
                <div class="card-title">{s.title}</div>
              </a>
            ))}
          </div>
        </section>
      )}

      {detail.related_characters.length > 0 && (
        <section class="related">
          <h2>{t(locale, "prayer.relatedCharacters")}</h2>
          <div class="char-row">
            {detail.related_characters.map((ch) => (
              <a href={localePath(`/characters/${ch.id}`, locale)} class="char-chip">
                <span class="char-chip-emoji">👤</span>
                <span class="char-chip-name">{ch.name}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="faq-section">
        <h2>{t(locale, "prayer.faqTitle")}</h2>
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    </div>

    {morePrayers.length > 0 && (
      <section class="more-prayers">
        <h2>{t(locale, "prayer.morePrayers")}</h2>
        <div class="more-grid">
          {morePrayers.map((p) => (
            <a href={localePath(`/prayers/${p.slug}`, locale)} class="more-card">
              <div class="more-card-title">{p.title}</div>
              <div class="more-card-desc">{p.description}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="bottom-cta">
      <h2>{t(locale, "prayer.listenOn")}</h2>
      <p>{t(locale, "prayer.listenOnDesc")}</p>
      <StoreButtons variant="hero" />
    </section>
  </main>
</Base>

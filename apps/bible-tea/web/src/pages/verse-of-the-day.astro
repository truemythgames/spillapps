---
import Base from "../layouts/Base.astro";
import StoreButtons from "../components/StoreButtons.astro";
import { APP_STORE_URL } from "../lib/stories";
import { getLocale, localePath, t } from "../lib/i18n";
import { verseOfTheDaySeo } from "../lib/seo";
import { getVerseOfTheDay, getUpcomingVerses } from "../lib/daily-verses";
import { getVerseReflection } from "../lib/verse-reflections";

const locale = getLocale(Astro.currentLocale);
const now = new Date();
const verse = getVerseOfTheDay(now, locale);
const verseEn = getVerseOfTheDay(now, "en");
const reflection = getVerseReflection(verseEn, verse, locale);
const upcoming = getUpcomingVerses(locale, 7);
const today = now.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });

const { title, description } = verseOfTheDaySeo(locale, verse, now);
const faqA5 = t(locale, "votd.faqA5").replace("{ref}", verse.ref).replace("{text}", verse.text);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://bibletea.app/" },
    { "@type": "ListItem", position: 2, name: "Verse of the Day", item: "https://bibletea.app/verse-of-the-day/" },
  ],
};

const quoteLd = {
  "@context": "https://schema.org",
  "@type": "Quotation",
  text: verse.text,
  isPartOf: { "@type": "CreativeWork", name: verse.ref },
  creator: { "@type": "Organization", name: "Bible Tea" },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: t(locale, "votd.faqQ1"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA1") } },
    { "@type": "Question", name: t(locale, "votd.faqQ2"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA2") } },
    { "@type": "Question", name: t(locale, "votd.faqQ3"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA3") } },
    { "@type": "Question", name: t(locale, "votd.faqQ4"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA4") } },
    { "@type": "Question", name: t(locale, "votd.faqQ5"), acceptedAnswer: { "@type": "Answer", text: faqA5 } },
    { "@type": "Question", name: t(locale, "votd.faqQ6"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA6") } },
    { "@type": "Question", name: t(locale, "votd.faqQ7"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA7") } },
    { "@type": "Question", name: t(locale, "votd.faqQ8"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA8") } },
    { "@type": "Question", name: t(locale, "votd.faqQ9"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA9") } },
    { "@type": "Question", name: t(locale, "votd.faqQ10"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA10") } },
  ],
};

const appLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Bible Tea",
  operatingSystem: "iOS, Android",
  applicationCategory: "ReligionApplication",
  url: "https://bibletea.app/",
  image: "https://bibletea.app/icon.png",
  description: "Bible stories as immersive audio, daily verse widget, guided prayers.",
  aggregateRating: { "@type": "AggregateRating", ratingValue: "5", ratingCount: "50", bestRating: "5" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: "https://bibletea.app/verse-of-the-day/",
  isPartOf: { "@type": "WebSite", name: "Bible Tea", url: "https://bibletea.app/" },
  about: { "@type": "Thing", name: "Bible Verse of the Day" },
  dateModified: new Date().toISOString(),
};
---

<Base title={title} description={description} canonicalPath="/verse-of-the-day" esPath="/versiculo-del-dia" jsonLd={[breadcrumbLd, quoteLd, faqLd, appLd, webPageLd]}>
  <style>
    .bc { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); max-width: 1200px; margin: 0 auto; padding: 6.5rem 2rem 0; }
    .bc a { color: var(--text-muted); text-decoration: none; transition: color 0.2s; }
    .bc a:hover { color: var(--primary); }
    .bc .sep { opacity: 0.4; }

    .votd-hero {
      padding: 2rem 2rem 2rem;
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }
    .votd-date { font-size: 0.85rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 1rem; }
    .votd-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .votd-hero p {
      color: var(--text-secondary);
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }

    .votd-content { max-width: 1200px; margin: 0 auto; padding: 0 2rem 4rem; }
    .verse-card {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 20px;
      padding: 3rem 2.5rem;
      text-align: center;
      margin-bottom: 1.5rem;
      position: relative;
      overflow: hidden;
    }
    .verse-card::before {
      content: '';
      position: absolute;
      top: -40%;
      left: 50%;
      transform: translateX(-50%);
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(200, 162, 255, 0.06) 0%, transparent 70%);
      pointer-events: none;
    }
    .verse-quote { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
    .verse-text {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700;
      line-height: 1.4;
      margin-bottom: 1.25rem;
      color: var(--text);
    }
    .verse-ref { font-size: 1rem; font-weight: 600; color: var(--primary); }

    .verse-cta {
      text-align: center;
      margin-bottom: 3rem;
    }
    .verse-cta-text {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    .widget-promo {
      background: linear-gradient(135deg, rgba(200, 162, 255, 0.1) 0%, rgba(107, 92, 231, 0.1) 100%);
      border: 1px solid rgba(200, 162, 255, 0.25);
      border-radius: 20px;
      padding: 2.5rem;
      margin-bottom: 4rem;
      text-align: center;
    }
    .widget-promo-badge {
      display: inline-block;
      background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
      color: #000;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      padding: 0.35rem 1rem;
      border-radius: 999px;
      margin-bottom: 1.25rem;
    }
    .widget-promo h2 {
      font-size: 1.5rem;
      margin-bottom: 0.75rem;
    }
    .widget-promo-desc {
      color: var(--text-secondary);
      font-size: 1rem;
      line-height: 1.7;
      max-width: 520px;
      margin: 0 auto 1.25rem;
    }
    .widget-features {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    .widget-feature {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      color: var(--text);
    }
    .widget-feature-check {
      color: var(--primary);
      font-weight: 700;
    }
    .widget-promo-link {
      display: inline-block;
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }
    .widget-promo-link:hover { text-decoration: underline; }

    .upcoming { margin-bottom: 4rem; }
    .upcoming h2 { font-size: 1.5rem; margin-bottom: 1.5rem; }
    .upcoming-list { display: flex; flex-direction: column; gap: 1rem; }
    .upcoming-item {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      transition: border-color 0.3s;
    }
    .upcoming-item:first-child { border-color: var(--primary); }
    .upcoming-item:hover { border-color: rgba(200, 162, 255, 0.3); }
    .upcoming-day {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent);
      min-width: 90px;
      padding-top: 0.15rem;
    }
    .upcoming-item:first-child .upcoming-day { color: var(--primary); }
    .upcoming-verse { flex: 1; }
    .upcoming-text {
      font-family: 'Playfair Display', serif;
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.5;
      margin-bottom: 0.25rem;
    }
    .upcoming-ref { font-size: 0.8rem; color: var(--text-muted); }

    .mid-cta {
      text-align: center;
      padding: 2.5rem 2rem;
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 20px;
      margin-bottom: 4rem;
    }
    .mid-cta h2 { font-size: 1.35rem; margin-bottom: 0.5rem; }
    .mid-cta p { color: var(--text-secondary); margin-bottom: 1.25rem; font-size: 0.95rem; }

    .about-section { margin-bottom: 4rem; }
    .about-section h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .about-section p { color: var(--text-secondary); line-height: 1.8; margin-bottom: 1rem; font-size: 1rem; }

    .faq { margin-bottom: 4rem; }
    .faq h2 { font-size: 1.5rem; margin-bottom: 1.5rem; }
    .faq-item { margin-bottom: 1.5rem; }
    .faq-item h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text); }
    .faq-item p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; }

    .final-cta {
      text-align: center;
      padding: 3rem 2rem;
      background: linear-gradient(135deg, rgba(200, 162, 255, 0.08) 0%, rgba(107, 92, 231, 0.08) 100%);
      border: 1px solid rgba(200, 162, 255, 0.2);
      border-radius: 20px;
      margin-bottom: 4rem;
    }
    .final-cta-icon { font-size: 3rem; margin-bottom: 1rem; }
    .final-cta h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
    .final-cta-sub { color: var(--text-secondary); margin-bottom: 0.75rem; }
    .final-cta-stars { display: flex; justify-content: center; gap: 0.25rem; margin-bottom: 0.4rem; font-size: 1.1rem; color: var(--accent); }
    .final-cta-proof { text-align: center; color: var(--text-muted); font-size: 0.8rem; font-weight: 600; margin-bottom: 1.5rem; }

    .reflection { margin-bottom: 3rem; }
    .reflection h2 { font-size: 1.35rem; margin-bottom: 1.25rem; }
    .reflection-body { color: var(--text-secondary); line-height: 1.8; font-size: 1.05rem; margin-bottom: 1.25rem; }
    .reflection-q {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      font-size: 1rem;
      color: var(--text);
      line-height: 1.6;
      font-style: italic;
      margin-bottom: 1.25rem;
    }
    .reflection-related {
      display: block;
      color: var(--primary);
      font-weight: 600;
      text-decoration: none;
      font-size: 0.95rem;
    }
    .reflection-related:hover { text-decoration: underline; }
    .reflection-related-label { display: block; color: var(--text-muted); font-size: 0.8rem; font-weight: 600; margin-bottom: 0.35rem; font-style: normal; }

    .why-section { margin-bottom: 4rem; }
    .why-section h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .why-section p { color: var(--text-secondary); line-height: 1.8; margin-bottom: 1rem; font-size: 1rem; }

    @media (max-width: 640px) {
      .bc { padding: 5.5rem 1.25rem 0; }
      .votd-hero { padding: 1.5rem 1.25rem; }
      .votd-content { padding: 0 1.25rem 3rem; }
      .verse-card { padding: 2rem 1.5rem; }
      .widget-promo { padding: 2rem 1.5rem; }
      .widget-features { flex-direction: column; align-items: center; gap: 0.75rem; }
      .upcoming-item { flex-direction: column; gap: 0.5rem; }
      .upcoming-day { min-width: auto; }
    }
  </style>

  <main>
    <div class="bc" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "votd.breadcrumbHome")}</a><span class="sep">/</span>
      <span>{t(locale, "votd.breadcrumbVerse")}</span>
    </div>
    <div class="votd-hero">
      <p class="votd-date">{today}</p>
      <h1>{t(locale, "votd.h1")}</h1>
      <div class="hero-download"><StoreButtons variant="hero" /></div>
      <p>{t(locale, "votd.subtitle")}</p>
    </div>

    <div class="votd-content">
    <div class="verse-card">
      <p class="verse-quote">{t(locale, "votd.verseLabel")}</p>
      <blockquote>
        <p class="verse-text">"{verse.text}"</p>
      </blockquote>
      <p class="verse-ref">{verse.ref}</p>
    </div>
    <p style="text-align:center;margin:-0.5rem 0 2rem;">
      <a href={localePath("/prayer-for-today", locale)} style="color:var(--primary);font-weight:600;text-decoration:none;margin-right:1.25rem;">{t(locale, "votd.pftLink")}</a>
      <a href={localePath("/verses", locale)} style="color:var(--primary);font-weight:600;text-decoration:none;">{t(locale, "votd.versesLink")}</a>
    </p>

    <section class="reflection">
      <h2 class="heading">{t(locale, "votd.reflectionTitle")}</h2>
      <p class="reflection-body">{reflection.body}</p>
      <div class="reflection-q">{reflection.question}</div>
      <span class="reflection-related-label">{t(locale, "votd.relatedStory")}</span>
      <a class="reflection-related" href={reflection.related.href}>{t(locale, "votd.relatedStoryCta").replace("{title}", reflection.related.label)}</a>
    </section>

    <div class="verse-cta">
      <p class="verse-cta-text">{t(locale, "votd.listenCta")}</p>
      <StoreButtons variant="hero" />
    </div>

    <div class="widget-promo">
      <div class="widget-promo-badge">{t(locale, "votd.widgetBadge")}</div>
      <h2 class="heading">{t(locale, "votd.widgetTitle")}</h2>
      <p class="widget-promo-desc">{t(locale, "votd.widgetDesc")}</p>
      <div class="widget-features">
        <div class="widget-feature"><span class="widget-feature-check">✓</span> {t(locale, "votd.widgetF1")}</div>
        <div class="widget-feature"><span class="widget-feature-check">✓</span> {t(locale, "votd.widgetF2")}</div>
        <div class="widget-feature"><span class="widget-feature-check">✓</span> {t(locale, "votd.widgetF3")}</div>
      </div>
      <StoreButtons variant="hero" />
    </div>

    <section class="upcoming">
      <h2 class="heading">{t(locale, "votd.upcomingTitle")}</h2>
      <div class="upcoming-list">
        {upcoming.map((v) => (
          <div class="upcoming-item">
            <span class="upcoming-day">{v.dayLabel}</span>
            <div class="upcoming-verse">
              <p class="upcoming-text">"{v.text}"</p>
              <p class="upcoming-ref">{v.ref}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mid-cta">
      <h2 class="heading">{t(locale, "votd.midCtaTitle")}</h2>
      <p>{t(locale, "votd.midCtaDesc")}</p>
      <StoreButtons variant="light" />
    </section>

    <section class="about-section">
      <h2 class="heading">{t(locale, "votd.aboutTitle")}</h2>
      <p>{t(locale, "votd.aboutP1")}</p>
      <p>{t(locale, "votd.aboutP2")}</p>
      <p>{t(locale, "votd.aboutP3")}</p>
    </section>

    <section class="why-section">
      <h2 class="heading">{t(locale, "votd.whyTitle")}</h2>
      <p>{t(locale, "votd.whyP1")}</p>
      <p>{t(locale, "votd.whyP2")}</p>
      <p>{t(locale, "votd.whyP3")}</p>
    </section>

    <section class="faq">
      <h2 class="heading">{t(locale, "votd.faqTitle")}</h2>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ1")}</h3><p>{t(locale, "votd.faqA1")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ2")}</h3><p>{t(locale, "votd.faqA2")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ3")}</h3><p>{t(locale, "votd.faqA3")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ4")}</h3><p>{t(locale, "votd.faqA4")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ5")}</h3><p>{faqA5}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ6")}</h3><p>{t(locale, "votd.faqA6")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ7")}</h3><p>{t(locale, "votd.faqA7")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ8")}</h3><p>{t(locale, "votd.faqA8")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ9")}</h3><p>{t(locale, "votd.faqA9")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ10")}</h3><p>{t(locale, "votd.faqA10")}</p></div>
    </section>

    <section class="final-cta">
      <div class="final-cta-icon">🍵</div>
      <h2 class="heading">{t(locale, "votd.finalCtaTitle")}</h2>
      <p class="final-cta-sub">{t(locale, "votd.finalCtaDesc")}</p>
      <div class="final-cta-stars">★★★★★</div>
      <div class="final-cta-proof">{t(locale, "votd.proofStars")}</div>
      <StoreButtons variant="light" />
    </section>
    </div>
  </main>
</Base>

---
import Base from "../layouts/Base.astro";
import StoreButtons from "../components/StoreButtons.astro";
import { APP_STORE_URL } from "../lib/stories";
import { getLocale, localePath, t } from "../lib/i18n";
import { getVerseOfTheDay, getUpcomingVerses } from "../lib/daily-verses";

const locale = getLocale(Astro.currentLocale);
const verse = getVerseOfTheDay(new Date(), locale);
const upcoming = getUpcomingVerses(locale, 7);
const today = new Date().toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });

const title = t(locale, "votd.title");
const description = t(locale, "votd.description");

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://bibletea.app/" },
    { "@type": "ListItem", position: 2, name: "Verse of the Day", item: "https://bibletea.app/verse-of-the-day/" },
  ],
};

const quoteLd = {
  "@context": "https://schema.org",
  "@type": "Quotation",
  text: verse.text,
  spokenByCharacter: { "@type": "Thing", name: "The Bible" },
  isPartOf: { "@type": "CreativeWork", name: verse.ref },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: t(locale, "votd.faqQ1"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA1") } },
    { "@type": "Question", name: t(locale, "votd.faqQ2"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA2") } },
    { "@type": "Question", name: t(locale, "votd.faqQ3"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA3") } },
    { "@type": "Question", name: t(locale, "votd.faqQ4"), acceptedAnswer: { "@type": "Answer", text: t(locale, "votd.faqA4") } },
  ],
};

const appLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Bible Tea",
  operatingSystem: "iOS, Android",
  applicationCategory: "ReligionApplication",
  url: "https://bibletea.app",
  image: "https://bibletea.app/icon.png",
  description: "Bible stories as immersive audio, daily verse widget, guided prayers.",
  aggregateRating: { "@type": "AggregateRating", ratingValue: "5", ratingCount: "50", bestRating: "5" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const webPageLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: "https://bibletea.app/verse-of-the-day/",
  isPartOf: { "@type": "WebSite", name: "Bible Tea", url: "https://bibletea.app" },
  about: { "@type": "Thing", name: "Bible Verse of the Day" },
  dateModified: new Date().toISOString(),
};
---

<Base title={title} description={description} canonicalPath="/verse-of-the-day" esPath="/versiculo-del-dia" jsonLd={[breadcrumbLd, quoteLd, faqLd, appLd, webPageLd]}>
  <style>
    .votd-page { max-width: 1200px; margin: 0 auto; padding: 7rem 2rem 4rem; }
    .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 2rem; }
    .breadcrumb a { color: var(--primary); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    .votd-hero { text-align: center; margin-bottom: 3rem; }
    .votd-date { font-size: 0.85rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 1rem; }
    .votd-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.15; margin-bottom: 1rem; }
    .votd-hero-sub { color: var(--text-secondary); font-size: 1.1rem; max-width: 560px; margin: 0 auto 1.5rem; line-height: 1.7; }
    .hero-proof { display: flex; align-items: center; justify-content: center; gap: 0.4rem; color: var(--accent); font-size: 0.9rem; font-weight: 600; }
    .hero-proof svg { width: 16px; height: 16px; }

    .verse-card {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 20px;
      padding: 3rem 2.5rem;
      text-align: center;
      margin-bottom: 1.5rem;
      position: relative;
      overflow: hidden;
    }
    .verse-card::before {
      content: '';
      position: absolute;
      top: -40%;
      left: 50%;
      transform: translateX(-50%);
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(200, 162, 255, 0.06) 0%, transparent 70%);
      pointer-events: none;
    }
    .verse-quote { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
    .verse-text {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 700;
      line-height: 1.4;
      margin-bottom: 1.25rem;
      color: var(--text);
    }
    .verse-ref { font-size: 1rem; font-weight: 600; color: var(--primary); }

    .verse-cta {
      text-align: center;
      margin-bottom: 3rem;
    }
    .verse-cta-text {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    .widget-promo {
      background: linear-gradient(135deg, rgba(200, 162, 255, 0.1) 0%, rgba(107, 92, 231, 0.1) 100%);
      border: 1px solid rgba(200, 162, 255, 0.25);
      border-radius: 20px;
      padding: 2.5rem;
      margin-bottom: 4rem;
      text-align: center;
    }
    .widget-promo-badge {
      display: inline-block;
      background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
      color: #000;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      padding: 0.35rem 1rem;
      border-radius: 999px;
      margin-bottom: 1.25rem;
    }
    .widget-promo h2 {
      font-size: 1.5rem;
      margin-bottom: 0.75rem;
    }
    .widget-promo-desc {
      color: var(--text-secondary);
      font-size: 1rem;
      line-height: 1.7;
      max-width: 520px;
      margin: 0 auto 1.25rem;
    }
    .widget-features {
      display: flex;
      justify-content: center;
      gap: 2rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }
    .widget-feature {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      color: var(--text);
    }
    .widget-feature-check {
      color: var(--primary);
      font-weight: 700;
    }
    .widget-promo-link {
      display: inline-block;
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }
    .widget-promo-link:hover { text-decoration: underline; }

    .upcoming { margin-bottom: 4rem; }
    .upcoming h2 { font-size: 1.5rem; margin-bottom: 1.5rem; }
    .upcoming-list { display: flex; flex-direction: column; gap: 1rem; }
    .upcoming-item {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      transition: border-color 0.3s;
    }
    .upcoming-item:first-child { border-color: var(--primary); }
    .upcoming-item:hover { border-color: rgba(200, 162, 255, 0.3); }
    .upcoming-day {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent);
      min-width: 90px;
      padding-top: 0.15rem;
    }
    .upcoming-item:first-child .upcoming-day { color: var(--primary); }
    .upcoming-verse { flex: 1; }
    .upcoming-text {
      font-family: 'Playfair Display', serif;
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.5;
      margin-bottom: 0.25rem;
    }
    .upcoming-ref { font-size: 0.8rem; color: var(--text-muted); }

    .mid-cta {
      text-align: center;
      padding: 2.5rem 2rem;
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 20px;
      margin-bottom: 4rem;
    }
    .mid-cta h2 { font-size: 1.35rem; margin-bottom: 0.5rem; }
    .mid-cta p { color: var(--text-secondary); margin-bottom: 1.25rem; font-size: 0.95rem; }

    .about-section { margin-bottom: 4rem; }
    .about-section h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .about-section p { color: var(--text-secondary); line-height: 1.8; margin-bottom: 1rem; font-size: 1rem; }

    .faq { margin-bottom: 4rem; }
    .faq h2 { font-size: 1.5rem; margin-bottom: 1.5rem; }
    .faq-item { margin-bottom: 1.5rem; }
    .faq-item h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text); }
    .faq-item p { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; }

    .final-cta {
      text-align: center;
      padding: 3rem 2rem;
      background: linear-gradient(135deg, rgba(200, 162, 255, 0.08) 0%, rgba(107, 92, 231, 0.08) 100%);
      border: 1px solid rgba(200, 162, 255, 0.2);
      border-radius: 20px;
      margin-bottom: 4rem;
    }
    .final-cta-icon { font-size: 3rem; margin-bottom: 1rem; }
    .final-cta h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
    .final-cta-sub { color: var(--text-secondary); margin-bottom: 0.75rem; }
    .final-cta-proof { display: flex; align-items: center; justify-content: center; gap: 0.3rem; color: var(--accent); font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem; }
    .final-cta-proof svg { width: 14px; height: 14px; }

    @media (max-width: 640px) {
      .votd-page { padding: 6rem 1.5rem 3rem; }
      .verse-card { padding: 2rem 1.5rem; }
      .widget-promo { padding: 2rem 1.5rem; }
      .widget-features { flex-direction: column; align-items: center; gap: 0.75rem; }
      .upcoming-item { flex-direction: column; gap: 0.5rem; }
      .upcoming-day { min-width: auto; }
    }
  </style>

  <div class="votd-page">
    <div class="breadcrumb" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "votd.breadcrumbHome")}</a>
      <span>›</span>
      <span>{t(locale, "votd.breadcrumbVerse")}</span>
    </div>

    <div class="votd-hero">
      <p class="votd-date">{today}</p>
      <h1 class="heading">{t(locale, "votd.h1")}</h1>
      <p class="votd-hero-sub">{t(locale, "votd.subtitle")}</p>
      <div class="hero-proof">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        {t(locale, "votd.proofStars")}
      </div>
    </div>

    <div class="verse-card">
      <p class="verse-quote">{t(locale, "votd.verseLabel")}</p>
      <blockquote>
        <p class="verse-text">"{verse.text}"</p>
      </blockquote>
      <p class="verse-ref">{verse.ref}</p>
    </div>

    <div class="verse-cta">
      <p class="verse-cta-text">{t(locale, "votd.listenCta")}</p>
      <StoreButtons variant="hero" />
    </div>

    <div class="widget-promo">
      <div class="widget-promo-badge">{t(locale, "votd.widgetBadge")}</div>
      <h2 class="heading">{t(locale, "votd.widgetTitle")}</h2>
      <p class="widget-promo-desc">{t(locale, "votd.widgetDesc")}</p>
      <div class="widget-features">
        <div class="widget-feature"><span class="widget-feature-check">✓</span> {t(locale, "votd.widgetF1")}</div>
        <div class="widget-feature"><span class="widget-feature-check">✓</span> {t(locale, "votd.widgetF2")}</div>
        <div class="widget-feature"><span class="widget-feature-check">✓</span> {t(locale, "votd.widgetF3")}</div>
      </div>
      <StoreButtons variant="hero" />
    </div>

    <section class="upcoming">
      <h2 class="heading">{t(locale, "votd.upcomingTitle")}</h2>
      <div class="upcoming-list">
        {upcoming.map((v) => (
          <div class="upcoming-item">
            <span class="upcoming-day">{v.dayLabel}</span>
            <div class="upcoming-verse">
              <p class="upcoming-text">"{v.text}"</p>
              <p class="upcoming-ref">{v.ref}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mid-cta">
      <h2 class="heading">{t(locale, "votd.midCtaTitle")}</h2>
      <p>{t(locale, "votd.midCtaDesc")}</p>
      <StoreButtons variant="light" />
    </section>

    <section class="about-section">
      <h2 class="heading">{t(locale, "votd.aboutTitle")}</h2>
      <p>{t(locale, "votd.aboutP1")}</p>
      <p>{t(locale, "votd.aboutP2")}</p>
      <p>{t(locale, "votd.aboutP3")}</p>
    </section>

    <section class="faq">
      <h2 class="heading">{t(locale, "votd.faqTitle")}</h2>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ1")}</h3><p>{t(locale, "votd.faqA1")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ2")}</h3><p>{t(locale, "votd.faqA2")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ3")}</h3><p>{t(locale, "votd.faqA3")}</p></div>
      <div class="faq-item"><h3>{t(locale, "votd.faqQ4")}</h3><p>{t(locale, "votd.faqA4")}</p></div>
    </section>

    <section class="final-cta">
      <div class="final-cta-icon">🍵</div>
      <h2 class="heading">{t(locale, "votd.finalCtaTitle")}</h2>
      <p class="final-cta-sub">{t(locale, "votd.finalCtaDesc")}</p>
      <div class="final-cta-proof">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>
        {t(locale, "votd.proofStars")}
      </div>
      <StoreButtons variant="light" />
    </section>
  </div>
</Base>

---
import Base from "../../../layouts/Base.astro";
import StoreButtons from "../../../components/StoreButtons.astro";
import { getPrayerCategories, getPrayers, type Prayer } from "../../../lib/stories";
import { getLocale, localePath, t } from "../../../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const [categories, prayers] = await Promise.all([
  getPrayerCategories(locale),
  getPrayers(locale),
]);

const CATEGORY_EMOJI: Record<string, string> = {
  "cloud-rain": "🌧️",
  moon: "🌙",
  sun: "☀️",
  "heart-pulse": "💗",
  shield: "🛡️",
  flame: "🔥",
  heart: "❤️",
  users: "🤝",
  compass: "🧭",
  sunrise: "🌅",
  sprout: "🌱",
  star: "⭐",
  cross: "✝️",
  hand: "🙏",
};
function catEmoji(icon: string | undefined): string {
  return (icon && CATEGORY_EMOJI[icon]) || "🙏";
}

const prayersByCategory = new Map<string, Prayer[]>();
for (const p of prayers) {
  const arr = prayersByCategory.get(p.category_id) || [];
  arr.push(p);
  prayersByCategory.set(p.category_id, arr);
}

const orderedCategories = categories.filter((c) => (prayersByCategory.get(c.id) || []).length > 0);

const title = t(locale, "prayers.title");
const description = t(locale, "prayers.description");

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Oraciones Guiadas",
  description,
  url: "https://bibletea.app/es/prayers/",
  publisher: {
    "@type": "Organization",
    name: "Bible Tea",
    logo: { "@type": "ImageObject", url: "https://bibletea.app/icon.png" },
  },
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Oraciones Guiadas",
  numberOfItems: prayers.length,
  itemListElement: prayers.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "WebPage", name: p.title, url: `https://bibletea.app/es/prayers/${p.slug}/` },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://bibletea.app/es/" },
    { "@type": "ListItem", position: 2, name: "Oraciones", item: "https://bibletea.app/es/prayers/" },
  ],
};

function faqT(key: string): string {
  return t(locale, key as any)
    .replace(/\{count\}/g, String(prayers.length))
    .replace(/\{cats\}/g, String(orderedCategories.length));
}
const faqs = [
  { q: faqT("prayers.faqQ1"), a: faqT("prayers.faqA1") },
  { q: faqT("prayers.faqQ2"), a: faqT("prayers.faqA2") },
  { q: faqT("prayers.faqQ3"), a: faqT("prayers.faqA3") },
];
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const jsonLdArray = [collectionLd, itemListLd, breadcrumbLd, faqLd];
---

<Base title={title} description={description} canonicalPath="/prayers" jsonLd={jsonLdArray}>
  <style>
    .bc { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--text-muted); max-width: 1200px; margin: 0 auto; padding: 6.5rem 2rem 0; }
    .bc a { color: var(--text-muted); text-decoration: none; transition: color 0.2s; }
    .bc a:hover { color: var(--primary); }
    .bc .sep { opacity: 0.4; }

    .hero-stars { display: flex; justify-content: center; gap: 0.25rem; margin-bottom: 0.5rem; font-size: 1.25rem; color: var(--accent); }
    .hero-proof { text-align: center; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 1.5rem; }

    .prayers-hero {
      padding: 2rem 2rem 2rem;
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }
    .prayers-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .prayers-hero p { color: var(--text-secondary); font-size: 1.1rem; line-height: 1.7; margin-bottom: 1.5rem; }

    .prayers-page { max-width: 1200px; margin: 0 auto; padding: 2rem 2rem 0; }

    .cat-block { margin-bottom: 3rem; }
    .cat-head { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 0.35rem; }
    .cat-emoji {
      width: 48px; height: 48px; flex-shrink: 0; border-radius: 14px;
      background: var(--surface-light); display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem; border: 1px solid var(--surface-border);
    }
    .cat-title { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; }
    .cat-desc { color: var(--text-muted); font-size: 0.9rem; margin: 0 0 1.25rem 0; }

    .prayer-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;
    }
    .prayer-card {
      display: block; text-decoration: none; background: var(--surface);
      border: 1px solid var(--surface-border); border-radius: 14px; padding: 1.25rem 1.35rem;
      transition: transform 0.2s, border-color 0.2s;
    }
    .prayer-card:hover { transform: translateY(-4px); border-color: var(--primary); }
    .prayer-card-title { font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 700; color: var(--text); line-height: 1.3; margin-bottom: 0.4rem; }
    .prayer-card-desc { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

    .faq-section { max-width: 700px; margin: 0 auto; padding: 3rem 2rem; border-top: 1px solid var(--surface-border); }
    .faq-section h2 { font-family: 'Playfair Display', serif; font-size: 1.5rem; margin-bottom: 1.25rem; }
    .faq-item { background: var(--surface); border: 1px solid var(--surface-border); border-radius: 12px; margin-bottom: 0.6rem; overflow: hidden; transition: border-color 0.2s; }
    .faq-item:hover { border-color: var(--primary); }
    .faq-item[open] { border-color: rgba(200, 162, 255, 0.3); }
    .faq-item summary { padding: 1rem 1.25rem; cursor: pointer; font-weight: 600; font-size: 0.95rem; color: var(--text); list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: '+'; font-size: 1.25rem; color: var(--primary); flex-shrink: 0; }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 1.25rem 1rem; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.7; }

    .bottom-cta { text-align: center; padding: 4rem 2rem 3rem; }
    .bottom-cta h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.75rem; }
    .bottom-cta p { color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 450px; margin-left: auto; margin-right: auto; }

    @media (max-width: 640px) {
      .prayers-hero { padding: 6rem 1.5rem 1.5rem; }
      .prayers-page { padding: 1.5rem 1.5rem 0; }
      .prayer-grid { grid-template-columns: 1fr; }
    }
  </style>

  <main>
    <div class="bc" role="navigation" aria-label="Breadcrumb">
      <a href={localePath("/", locale)}>{t(locale, "prayer.breadcrumbHome")}</a><span class="sep">/</span>
      <span>{t(locale, "prayer.breadcrumbPrayers")}</span>
    </div>
    <div class="prayers-hero">
      <h1>{t(locale, "prayers.h1")}</h1>
      <p>{t(locale, "prayers.subtitle")}</p>
      <div class="hero-stars">★★★★★</div>
      <div class="hero-proof">{t(locale, "home.stars")}</div>
      <StoreButtons variant="hero" />
    </div>

    <div class="prayers-page">
      {orderedCategories.map((cat) => (
        <section class="cat-block">
          <div class="cat-head">
            <div class="cat-emoji">{catEmoji(cat.icon)}</div>
            <h2 class="cat-title">{cat.name}</h2>
          </div>
          {cat.description && <p class="cat-desc">{cat.description}</p>}
          <div class="prayer-grid">
            {(prayersByCategory.get(cat.id) || []).map((p) => (
              <a href={localePath(`/prayers/${p.slug}`, locale)} class="prayer-card">
                <div class="prayer-card-title">{p.title}</div>
                <div class="prayer-card-desc">{p.description}</div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <section class="faq-section">
      <h2>{t(locale, "prayers.faqTitle")}</h2>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="bottom-cta">
      <h2>{t(locale, "prayers.ctaTitle")}</h2>
      <p>{t(locale, "prayers.ctaDesc")}</p>
      <StoreButtons variant="hero" />
    </section>
  </main>
</Base>

---
import Base from "../../../layouts/Base.astro";
import StoreButtons from "../../../components/StoreButtons.astro";
import { getCharacters } from "../../../lib/stories";
import { getLocale, localePath, t } from "../../../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const characters = await getCharacters(locale);

const title = t(locale, "characters.title");
const description = t(locale, "characters.description");

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Personajes Bíblicos",
  description,
  url: "https://bibletea.app/es/characters",
  publisher: {
    "@type": "Organization",
    name: "Bible Tea",
    logo: { "@type": "ImageObject", url: "https://bibletea.app/icon.png" },
  },
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Personajes Bíblicos",
  numberOfItems: characters.length,
  itemListElement: characters.map((ch, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: ch.name,
    url: `https://bibletea.app/es/characters/${ch.id}`,
    description: ch.description,
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://bibletea.app/es" },
    { "@type": "ListItem", position: 2, name: "Personajes Bíblicos", item: "https://bibletea.app/es/characters" },
  ],
};

const faqs = [
  {
    q: "¿Quiénes son los personajes principales de la Biblia?",
    a: `Bible Tea presenta ${characters.length} personajes bíblicos clave incluyendo ${characters.slice(0, 6).map((c) => c.name).join(", ")} y más. Cada página de personaje enlaza con las historias en las que aparecen, disponibles como audio inmersivo gratuito.`,
  },
  {
    q: "¿Puedo escuchar historias de personajes bíblicos gratis?",
    a: "¡Sí! Cada historia de personaje en Bible Tea es completamente gratuita. Descarga la app en iOS o Android y escucha el arco completo de cualquier personaje con narración profesional.",
  },
  {
    q: "¿Cuántos personajes bíblicos cubre Bible Tea?",
    a: `Bible Tea presenta actualmente ${characters.length} personajes del Antiguo y Nuevo Testamento, desde Adán y Eva hasta los apóstoles Pedro y Pablo.`,
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const jsonLdArray = [collectionLd, itemListLd, breadcrumbLd, faqLd];
---

<Base
  title={title}
  description={description}
  canonicalPath="/characters"
  jsonLd={jsonLdArray}
>
  <style>
    .characters-hero {
      padding: 7rem 2rem 2rem;
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }

    .characters-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .characters-hero p {
      color: var(--text-secondary);
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 1.5rem;
    }

    .characters-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 2rem 0;
    }

    .characters-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .char-card {
      text-decoration: none;
      text-align: center;
      transition: transform 0.25s;
    }

    .char-card:hover { transform: translateY(-6px); }

    .char-avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      margin: 0 auto 0.75rem;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.4);
      border: 3px solid var(--surface-border);
      display: block;
      transition: border-color 0.2s;
    }

    .char-card:hover .char-avatar { border-color: var(--primary); }

    .char-avatar-ph {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      margin: 0 auto 0.75rem;
      background: var(--surface-light);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      border: 3px solid var(--surface-border);
    }

    .char-name {
      font-family: 'Playfair Display', serif;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.2rem;
    }

    .char-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.3;
    }

    .char-count {
      font-size: 0.7rem;
      color: var(--accent);
      font-weight: 600;
      margin-top: 0.15rem;
    }

    .faq-section { max-width: 700px; margin: 0 auto; padding: 3rem 2rem; border-top: 1px solid var(--surface-border); }
    .faq-section h2 { font-family: 'Playfair Display', serif; font-size: 1.5rem; margin-bottom: 1.25rem; }
    .faq-item { background: var(--surface); border: 1px solid var(--surface-border); border-radius: 12px; margin-bottom: 0.6rem; overflow: hidden; transition: border-color 0.2s; }
    .faq-item:hover { border-color: var(--primary); }
    .faq-item[open] { border-color: rgba(200, 162, 255, 0.3); }
    .faq-item summary { padding: 1rem 1.25rem; cursor: pointer; font-weight: 600; font-size: 0.95rem; color: var(--text); list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: '+'; font-size: 1.25rem; color: var(--primary); flex-shrink: 0; }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { padding: 0 1.25rem 1rem; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.7; }

    .bottom-cta { text-align: center; padding: 4rem 2rem 3rem; }
    .bottom-cta h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: 0.75rem; }
    .bottom-cta p { color: var(--text-secondary); margin-bottom: 1.5rem; max-width: 450px; margin-left: auto; margin-right: auto; }
    .hero-cta { display: inline-flex; align-items: center; gap: 0.6rem; background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end)); color: #fff; padding: 0.8rem 2rem; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 1rem; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 24px rgba(200, 162, 255, 0.2); }
    .hero-cta:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(200, 162, 255, 0.35); }
    .hero-cta svg { width: 18px; height: 18px; }

    @media (max-width: 640px) {
      .characters-hero { padding: 6rem 1.5rem 1.5rem; }
      .characters-page { padding: 1.5rem 1.5rem 0; }
      .characters-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 1.5rem; }
      .char-avatar, .char-avatar-ph { width: 100px; height: 100px; }
    }
  </style>

  <main>
    <div class="characters-hero">
      <h1>{t(locale, "characters.h1")}</h1>
      <p>{t(locale, "characters.subtitle")}</p>
      <StoreButtons variant="hero" />
    </div>

    <div class="characters-page">
      <div class="characters-grid">
        {characters.map((ch) => (
          <a href={localePath(`/characters/${ch.id}`, locale)} class="char-card">
            {ch.image_url ? (
              <img src={ch.image_url} alt={ch.name} class="char-avatar" loading="lazy" width="120" height="120" />
            ) : (
              <div class="char-avatar-ph">👤</div>
            )}
            <div class="char-name">{ch.name}</div>
            <div class="char-desc">{ch.description}</div>
            {ch.stories.length > 0 && (
              <div class="char-count">{ch.stories.length} {t(locale, "characters.storyCount")}</div>
            )}
          </a>
        ))}
      </div>
    </div>

    <section class="faq-section">
      <h2>Preguntas Frecuentes</h2>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="bottom-cta">
      <h2>{t(locale, "characters.ctaTitle")}</h2>
      <p>{t(locale, "characters.ctaDesc")}</p>
      <StoreButtons variant="hero" />
    </section>
  </main>
</Base>

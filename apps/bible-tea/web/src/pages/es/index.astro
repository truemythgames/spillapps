---
import Base from "../../layouts/Base.astro";
import StoreButtons from "../../components/StoreButtons.astro";
import { MEDIA_BASE, getCatalog, getPlaylists } from "../../lib/stories";
import { getLocale, localePath, t } from "../../lib/i18n";

const locale = getLocale(Astro.currentLocale);
const catalog = getCatalog(locale);
const catalogMap = new Map(catalog.map((s) => [s.id, s]));
const playlists = await getPlaylists(catalog, locale);

const title = t(locale, "home.title");
const description = t(locale, "home.description");

const homeLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Bible Tea",
  operatingSystem: "iOS, Android",
  applicationCategory: "ReligionApplication",
  url: "https://bibletea.app",
  image: "https://bibletea.app/icon.png",
  description,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    ratingCount: "50",
    bestRating: "5",
  },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const featuredIds = [
  "creation", "adam-and-eve", "david-and-goliath", "jonah-and-the-whale",
  "the-prodigal-son", "crossing-the-red-sea", "daniel-and-the-lions-den",
  "the-resurrection", "samson-and-delilah", "ruth-and-naomi",
];
const storyCards = featuredIds
  .map((id) => catalogMap.get(id))
  .filter(Boolean)
  .map((s) => ({ id: s!.id, title: s!.title, ref: s!.bibleRef }));

const playlistCoverMap: Record<string, string> = {
  "pl-beginners": "creation",
  "pl-easter": "the-last-supper",
  "pl-love": "adam-and-eve",
  "pl-miracles": "crossing-the-red-sea",
  "pl-family": "joseph-and-his-brothers",
  "pl-jesus": "the-resurrection",
  "pl-courage": "daniel-and-the-lions-den",
  "pl-drama": "samson-and-delilah",
  "pl-underdogs": "david-and-goliath",
};
const playlistCards = playlists
  .filter((p) => playlistCoverMap[p.id])
  .map((p) => ({ cover: playlistCoverMap[p.id], name: p.name, id: p.id }));

const reviews = [
  { text: "Esta app cambió completamente la forma en que me acerco a la Biblia. Las narraciones son hermosas y las ilustraciones de cada historia son impresionantes. La escucho cada mañana con mi café.", name: "Sarah M.", initial: "S", date: "Marzo 2025" },
  { text: "Por fin una app que hace que las historias bíblicas cobren vida. A mis hijos les encanta escucharla antes de dormir. La Historia del Día nos hace volver cada día.", name: "James R.", initial: "J", date: "Marzo 2025" },
  { text: "He probado muchas apps de la Biblia y esta es la primera que realmente me emociona abrir. Las listas están perfectamente curadas y la calidad del audio es increíble.", name: "Maria L.", initial: "M", date: "Abril 2025" },
  { text: "Me encanta el estilo 'Spill the Tea' — hace que las Escrituras se sientan muy accesibles. La escucho durante mi viaje al trabajo y se ha convertido en la mejor parte de mi día. ¡Muy recomendada!", name: "David K.", initial: "D", date: "Abril 2025" },
  { text: "Los perfiles de personajes son una función muy inteligente. Seguir a Moisés a través de diferentes historias te da mucho más contexto. El diseño también es hermoso — el modo oscuro es perfecto.", name: "Anna T.", initial: "A", date: "Marzo 2025" },
  { text: "Como alguien que creció con estas historias, escucharlas narradas con tanto cuidado y emoción me hizo llorar. Así es como se deberían experimentar las Escrituras.", name: "Robert P.", initial: "R", date: "Abril 2025" },
];

const starSvg = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01z"/></svg>`;
---

<Base title={title} description={description} canonicalPath="/" jsonLd={homeLd}>
  <style>
    /* Hero */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 8rem 2rem 4rem;
      position: relative;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -20%;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(200, 162, 255, 0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-icon {
      width: 120px;
      height: 120px;
      border-radius: 28px;
      margin-bottom: 2rem;
      box-shadow: 0 20px 60px rgba(200, 162, 255, 0.15);
      animation: float 6s ease-in-out infinite;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    .hero h1 {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      line-height: 1.1;
      margin-bottom: 1.25rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-sub {
      font-size: clamp(1rem, 2vw, 1.2rem);
      color: var(--text-secondary);
      max-width: 520px;
      margin: 0 auto 2rem;
      line-height: 1.7;
    }
    .hero-proof {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--accent);
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 2rem;
      letter-spacing: 0.02em;
    }
    .hero-proof :global(svg) { width: 16px; height: 16px; flex-shrink: 0; }
    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
      color: #fff;
      padding: 1rem 2.5rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 30px rgba(200, 162, 255, 0.2);
    }
    .hero-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 40px rgba(200, 162, 255, 0.35);
    }
    .hero-cta :global(svg) { width: 20px; height: 20px; }

    /* Showcase */
    .showcase { padding: 4rem 2rem; overflow: hidden; }
    .showcase-title {
      text-align: center;
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      margin-bottom: 0.75rem;
    }
    .showcase-sub {
      text-align: center;
      color: var(--text-secondary);
      margin-bottom: 3rem;
      font-size: 1rem;
    }
    .card-scroll {
      display: flex;
      gap: 1.25rem;
      animation: scroll-left 40s linear infinite;
      width: max-content;
    }
    .card-scroll:hover { animation-play-state: paused; }
    @keyframes scroll-left {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .card-scroll-reverse {
      display: flex;
      gap: 1.25rem;
      animation: scroll-right 45s linear infinite;
      width: max-content;
      margin-top: 1.5rem;
    }
    .card-scroll-reverse:hover { animation-play-state: paused; }
    @keyframes scroll-right {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0); }
    }
    .story-card {
      flex-shrink: 0;
      width: 200px;
      border-radius: 16px;
      overflow: hidden;
      background: var(--surface);
      border: 1px solid var(--surface-border);
      transition: transform 0.3s, border-color 0.3s;
      display: block;
      text-decoration: none;
      color: inherit;
    }
    .story-card:hover { transform: translateY(-4px); border-color: var(--primary); }
    .story-card img { width: 200px; height: 200px; object-fit: cover; display: block; }
    .story-card-body { padding: 1rem; }
    .story-card-title {
      font-family: 'Playfair Display', serif;
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }
    .story-card-ref { font-size: 0.75rem; color: var(--text-muted); }
    .playlist-card {
      flex-shrink: 0;
      width: 240px;
      height: 120px;
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      border: 1px solid var(--surface-border);
      transition: transform 0.3s, border-color 0.3s;
      display: block;
      text-decoration: none;
      color: inherit;
    }
    .playlist-card:hover { transform: translateY(-4px); border-color: var(--primary); }
    .playlist-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .playlist-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(10,10,15,0.75) 0%, rgba(10,10,15,0.4) 100%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1rem 1.25rem;
    }
    .playlist-label {
      font-size: 0.65rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--accent);
      margin-bottom: 0.2rem;
    }
    .playlist-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: #fff;
    }

    /* Features */
    .features { padding: 6rem 2rem; max-width: 1000px; margin: 0 auto; }
    .features-title {
      text-align: center;
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      margin-bottom: 3rem;
    }
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }
    .feature-card {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 16px;
      padding: 2rem;
      transition: border-color 0.3s;
    }
    .feature-card:hover { border-color: rgba(200, 162, 255, 0.3); }
    .feature-icon { font-size: 2rem; margin-bottom: 1rem; }
    .feature-card h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem;
      margin-bottom: 0.5rem;
    }
    .feature-card p { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.7; }

    /* Reviews */
    .reviews { padding: 6rem 2rem; max-width: 1000px; margin: 0 auto; }
    .reviews-title {
      text-align: center;
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      margin-bottom: 0.5rem;
    }
    .reviews-subtitle {
      text-align: center;
      color: var(--text-secondary);
      margin-bottom: 3rem;
      font-size: 1rem;
    }
    .reviews-stars {
      display: flex;
      justify-content: center;
      gap: 0.25rem;
      margin-bottom: 0.75rem;
      font-size: 1.25rem;
      color: var(--accent);
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }
    .review-card {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 16px;
      padding: 1.75rem;
      transition: border-color 0.3s;
    }
    .review-card:hover { border-color: rgba(200, 162, 255, 0.3); }
    .review-stars { display: flex; gap: 2px; margin-bottom: 0.75rem; color: var(--accent); font-size: 0.9rem; }
    .review-text {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.7;
      margin-bottom: 1rem;
      font-style: italic;
    }
    .review-author { display: flex; align-items: center; gap: 0.75rem; }
    .review-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
      flex-shrink: 0;
    }
    .review-name { font-weight: 600; font-size: 0.9rem; color: var(--text); }
    .review-date { font-size: 0.75rem; color: var(--text-muted); }

    /* CTA */
    .cta-section { padding: 6rem 2rem; text-align: center; position: relative; }
    .cta-section::before {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 600px;
      height: 400px;
      background: radial-gradient(circle, rgba(107, 92, 231, 0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .cta-section h2 { font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: 1rem; }
    .cta-section p { color: var(--text-secondary); margin-bottom: 2rem; font-size: 1.1rem; }
    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background: #fff;
      color: #000;
      padding: 1rem 2.5rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .cta-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 40px rgba(255, 255, 255, 0.1); }
    .cta-btn :global(svg) { width: 20px; height: 20px; }

    /* Responsive */
    @media (max-width: 640px) {
      .hero { padding: 7rem 1.5rem 3rem; }
      .hero h1 { font-size: 2.25rem; }
      .hero-icon { width: 88px; height: 88px; border-radius: 20px; }
      .features { padding: 4rem 1.5rem; }
      .features-grid { grid-template-columns: 1fr; }
      .cta-section { padding: 4rem 1.5rem; }
      .story-card { width: 160px; }
      .story-card img { width: 160px; height: 160px; }
    }
  </style>

  <section class="hero">
    <img src="/icon-sm.png" alt="Ícono de Bible Tea" class="hero-icon" width="120" height="120" />
    <h1 class="heading">{t(locale, "home.h1a")}<br/>{t(locale, "home.h1b")}</h1>
    <p class="hero-sub">{t(locale, "home.subtitle")}</p>
    <div class="hero-proof">
      <Fragment set:html={starSvg} />
      <Fragment set:html={starSvg} />
      <Fragment set:html={starSvg} />
      <Fragment set:html={starSvg} />
      <Fragment set:html={starSvg} />
      {t(locale, "home.stars")}
    </div>
    <StoreButtons variant="hero" />
  </section>

  <section class="showcase">
    <h2 class="heading showcase-title">{t(locale, "home.showcaseTitle")}</h2>
    <p class="showcase-sub">{t(locale, "home.showcaseSub")}</p>
    <div style="overflow: hidden;">
      <div class="card-scroll" id="card-scroll">
        {storyCards.map((s) => (
          <a href={localePath(`/stories/${s.id}`, locale)} class="story-card">
            <img src={`${MEDIA_BASE}/stories/${s.id}/cover.webp`} alt={s.title} loading="lazy" decoding="async" width="200" height="200" />
            <div class="story-card-body">
              <div class="story-card-title">{s.title}</div>
              <div class="story-card-ref">{s.ref}</div>
            </div>
          </a>
        ))}
      </div>
      <div class="card-scroll-reverse" id="playlist-scroll">
        {playlistCards.map((p) => {
          const href = localePath(`/playlists/${p.id}`, locale);
          return (
            <a href={href} class="playlist-card">
              <img src={`${MEDIA_BASE}/stories/${p.cover}/cover.webp`} alt={p.name} loading="lazy" decoding="async" width="240" height="120" />
              <div class="playlist-overlay">
                <div class="playlist-label">{t(locale, "home.playlistLabel")}</div>
                <div class="playlist-name">{p.name}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="features">
    <h2 class="heading features-title">{t(locale, "home.featuresTitle")}</h2>
    <div class="features-grid">
      <div class="feature-card"><div class="feature-icon">🎧</div><h3>{t(locale, "home.feature1Title")}</h3><p>{t(locale, "home.feature1Desc")}</p></div>
      <div class="feature-card"><div class="feature-icon">🎨</div><h3>{t(locale, "home.feature2Title")}</h3><p>{t(locale, "home.feature2Desc")}</p></div>
      <div class="feature-card"><div class="feature-icon">📖</div><h3>{t(locale, "home.feature3Title")}</h3><p>{t(locale, "home.feature3Desc")}</p></div>
      <div class="feature-card"><div class="feature-icon">👤</div><h3>{t(locale, "home.feature4Title")}</h3><p>{t(locale, "home.feature4Desc")}</p></div>
      <div class="feature-card"><div class="feature-icon">🍵</div><h3>{t(locale, "home.feature5Title")}</h3><p>{t(locale, "home.feature5Desc")}</p></div>
      <div class="feature-card"><div class="feature-icon">🔥</div><h3>{t(locale, "home.feature6Title")}</h3><p>{t(locale, "home.feature6Desc")}</p></div>
    </div>
  </section>

  <section class="reviews">
    <h2 class="heading reviews-title">{t(locale, "home.reviewsTitle")}</h2>
    <div class="reviews-stars">★★★★★</div>
    <p class="reviews-subtitle">{t(locale, "home.reviewsSub")}</p>
    <div class="reviews-grid">
      {reviews.map((r) => (
        <div class="review-card">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">"{r.text}"</p>
          <div class="review-author">
            <div class="review-avatar">{r.initial}</div>
            <div>
              <div class="review-name">{r.name}</div>
              <div class="review-date">{r.date}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-section">
    <h2 class="heading">{t(locale, "home.ctaTitle")}</h2>
    <p>{t(locale, "home.ctaSub")}</p>
    <StoreButtons variant="light" />
  </section>

  <script is:inline>
    const scroll = document.getElementById('card-scroll');
    if (scroll) scroll.innerHTML += scroll.innerHTML;
    const plScroll = document.getElementById('playlist-scroll');
    if (plScroll) plScroll.innerHTML += plScroll.innerHTML;
  </script>
</Base>

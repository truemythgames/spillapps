---
import Base from "../../../layouts/Base.astro";
import StoreButtons from "../../../components/StoreButtons.astro";
import {
  getCatalog,
  getPlaylists,
  hasCover,
  coverUrl,
  type Playlist,
} from "../../../lib/stories";
import { getLocale, localePath, t } from "../../../lib/i18n";
import { playlistSeo, localizeBibleRef, clampTitle, clampDescription } from "../../../lib/seo";
import { playlistContent } from "../../../lib/playlist-content";

export async function getStaticPaths() {
  const catalog = getCatalog("es");
  const playlists = await getPlaylists(catalog, "es");
  return playlists.map((pl) => ({
    params: { id: pl.id },
    props: { playlist: pl, allPlaylists: playlists },
  }));
}

interface Props {
  playlist: Playlist;
  allPlaylists: Playlist[];
}

const { playlist, allPlaylists } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const stories = playlist.stories;

const seoOverride = playlistSeo(playlist.id, locale);
const pageTitle = clampTitle(seoOverride.title ?? t(locale, "playlist.pageTitle").replace("{name}", playlist.name));
const pageDesc = clampDescription(seoOverride.description ?? t(locale, "playlist.pageDesc").replace(/\{description\}/g, playlist.description).replace(/\{count\}/g, String(stories.length)).replace(/\{name\}/g, playlist.name));
const pageUrl = `https://bibletea.app/es/playlists/${playlist.id}/`;

const firstCover = stories.find((s) => hasCover(s.id));
const ogImage = firstCover ? coverUrl(firstCover.id) : "https://bibletea.app/icon.png";

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: playlist.name,
  description: playlist.description,
  url: pageUrl,
  publisher: {
    "@type": "Organization",
    name: "Bible Tea",
    logo: { "@type": "ImageObject", url: "https://bibletea.app/icon.png" },
  },
};

const itemListLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: playlist.name,
  description: playlist.description,
  numberOfItems: stories.length,
  itemListElement: stories.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "WebPage", name: s.title, url: `https://bibletea.app/es/stories/${s.id}/` },
  })),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: "https://bibletea.app/es/" },
    { "@type": "ListItem", position: 2, name: "Listas", item: "https://bibletea.app/es/playlists/" },
    { "@type": "ListItem", position: 3, name: playlist.name, item: pageUrl },
  ],
};

function faqT(key: string): string {
  return t(locale, key as any).replace(/\{name\}/g, playlist.name).replace(/\{count\}/g, String(stories.length));
}
const faqStoryList = stories.slice(0, 5).map((s) => s.title).join(", ") + (stories.length > 5 ? t(locale, "playlist.faqA1More").replace("{more}", String(stories.length - 5)) : "");
const faqRefs = stories.slice(0, 4).map((s) => s.bibleRef).join(", ") + (stories.length > 4 ? t(locale, "playlist.faqA3More") : "");
const faqs = [
  { q: faqT("playlist.faqQ1"), a: faqT("playlist.faqA1").replace("{stories}", faqStoryList) },
  { q: faqT("playlist.faqQ2"), a: faqT("playlist.faqA2") },
  { q: faqT("playlist.faqQ3"), a: faqT("playlist.faqA3").replace("{refs}", faqRefs) },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const jsonLdArray = [collectionLd, itemListLd, breadcrumbLd, faqLd];

const otherPlaylists = allPlaylists.filter((p) => p.id !== playlist.id).slice(0, 6);

const editorial = playlistContent(playlist.id, locale);
const storyById = new Map(stories.map((s) => [s.id, s]));
const guideEntries = (editorial?.guide ?? [])
  .map((g) => ({ ...g, story: storyById.get(g.id) }))
  .filter((g) => g.story);
---

<Base
  title={pageTitle}
  description={pageDesc}
  ogImage={ogImage}
  canonicalPath={`/playlists/${playlist.id}`}
  jsonLd={jsonLdArray}
>
  <style>
    .playlist-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 7rem 2rem 0;
    }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 2rem;
    }

    .breadcrumbs a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    .breadcrumbs a:hover { color: var(--primary); }
    .breadcrumbs .sep { opacity: 0.4; }

    .playlist-hero {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 3rem;
    }

    .playlist-hero h1 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 5vw, 3rem);
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, var(--text) 0%, var(--primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .playlist-hero p {
      color: var(--text-secondary);
      font-size: 1.1rem;
      line-height: 1.7;
      margin-bottom: 0.5rem;
    }

    .playlist-meta {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
      color: #fff;
      padding: 0.8rem 2rem;
      border-radius: 999px;
      text-decoration: none;
      font-weight: 600;
      font-size: 1rem;
      transition: transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 24px rgba(200, 162, 255, 0.2);
    }

    .hero-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(200, 162, 255, 0.35);
    }

    .hero-cta svg { width: 18px; height: 18px; }

    .stories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .story-card {
      text-decoration: none;
      transition: transform 0.25s;
    }

    .story-card:hover { transform: translateY(-6px) scale(1.02); }

    .card-cover {
      width: 100%;
      aspect-ratio: 1;
      border-radius: 14px;
      overflow: hidden;
      position: relative;
      margin-bottom: 0.6rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .card-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .card-cover-placeholder {
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, var(--surface) 0%, var(--surface-light) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
    }

    .card-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 0.5rem 0.65rem;
      background: linear-gradient(transparent, rgba(0,0,0,0.8));
    }

    .card-ref {
      font-size: 0.65rem;
      color: var(--accent);
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .card-title {
      font-family: 'Playfair Display', serif;
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.25;
      margin-top: 0.2rem;
    }

    .card-desc {
      font-size: 0.75rem;
      color: var(--text-muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-top: 0.2rem;
    }

    .playlist-intro {
      max-width: 700px;
      margin: -1.5rem auto 3rem;
    }

    .playlist-intro p {
      color: var(--text-secondary);
      font-size: 1rem;
      line-height: 1.8;
      margin-bottom: 1rem;
    }

    .story-guide {
      max-width: 700px;
      margin: 0 auto;
      padding: 3rem 0 1rem;
      border-top: 1px solid var(--surface-border);
    }

    .story-guide h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      margin-bottom: 1.75rem;
    }

    .guide-item { margin-bottom: 1.75rem; }

    .guide-item h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.1rem;
      margin-bottom: 0.15rem;
    }

    .guide-item h3 a {
      color: var(--text);
      text-decoration: none;
      transition: color 0.2s;
    }

    .guide-item h3 a:hover { color: var(--primary); }

    .guide-ref {
      font-size: 0.75rem;
      color: var(--accent);
      font-weight: 600;
      letter-spacing: 0.5px;
      margin-bottom: 0.35rem;
    }

    .guide-item p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.75;
    }

    .faq-section {
      max-width: 700px;
      margin: 0 auto;
      padding: 3rem 0;
      border-top: 1px solid var(--surface-border);
    }

    .faq-section h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.35rem;
      margin-bottom: 1rem;
    }

    .faq-item {
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 12px;
      margin-bottom: 0.6rem;
      overflow: hidden;
      transition: border-color 0.2s;
    }

    .faq-item:hover { border-color: var(--primary); }
    .faq-item[open] { border-color: rgba(200, 162, 255, 0.3); }

    .faq-item summary {
      padding: 1rem 1.25rem;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--text);
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .faq-item summary::-webkit-details-marker { display: none; }

    .faq-item summary::after {
      content: '+';
      font-size: 1.25rem;
      color: var(--primary);
      flex-shrink: 0;
    }

    .faq-item[open] summary::after { content: '−'; }

    .faq-item p {
      padding: 0 1.25rem 1rem;
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.7;
    }

    .more-playlists {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 2rem;
      border-top: 1px solid var(--surface-border);
    }

    .more-playlists h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.35rem;
      margin-bottom: 1.25rem;
    }

    .playlists-row {
      display: flex;
      gap: 1.25rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.75rem;
      scrollbar-width: none;
    }

    .playlists-row::-webkit-scrollbar { display: none; }

    .playlist-card {
      flex-shrink: 0;
      width: 220px;
      scroll-snap-align: start;
      text-decoration: none;
      background: var(--surface);
      border: 1px solid var(--surface-border);
      border-radius: 16px;
      padding: 1.5rem;
      transition: transform 0.2s, border-color 0.2s;
    }

    .playlist-card:hover {
      transform: translateY(-4px);
      border-color: var(--primary);
    }

    .pc-name {
      font-family: 'Playfair Display', serif;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.35rem;
    }

    .pc-count {
      font-size: 0.75rem;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .pc-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .bottom-cta {
      text-align: center;
      padding: 4rem 2rem 3rem;
    }

    .bottom-cta h2 {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.5rem, 3vw, 2rem);
      margin-bottom: 0.75rem;
    }

    .bottom-cta p {
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
      max-width: 450px;
      margin-left: auto;
      margin-right: auto;
    }

    @media (max-width: 640px) {
      .playlist-page { padding: 6rem 1.5rem 0; }
      .stories-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1rem; }
      .more-playlists { padding: 2rem 1.5rem; }
      .playlist-card { width: 180px; padding: 1.25rem; }
    }
  </style>

  <main>
    <div class="playlist-page">
      <div class="breadcrumbs">
        <a href={localePath("/", locale)}>{t(locale, "playlist.breadcrumbHome")}</a>
        <span class="sep">/</span>
        <a href={localePath("/playlists", locale)}>{t(locale, "playlist.breadcrumbPlaylists")}</a>
        <span class="sep">/</span>
        <span>{playlist.name}</span>
      </div>

      <div class="playlist-hero">
        <h1>{playlist.name}</h1>
        <p>{playlist.description}</p>
        <p class="playlist-meta">{stories.length} {t(locale, "playlists.storyCount")}</p>
        <StoreButtons variant="hero" />
      </div>

      {editorial && (
        <section class="playlist-intro">
          {editorial.intro.map((p) => <p>{p}</p>)}
        </section>
      )}

      <div class="stories-grid">
        {stories.map((s) => (
          <a href={localePath(`/stories/${s.id}`, locale)} class="story-card">
            <div class="card-cover">
              {hasCover(s.id) ? (
                <img src={coverUrl(s.id, 600)} alt={s.title} loading="lazy" width="300" height="300" />
              ) : (
                <div class="card-cover-placeholder">📖</div>
              )}
              <div class="card-overlay">
                <div class="card-ref">{localizeBibleRef(s.bibleRef, locale)}</div>
              </div>
            </div>
            <div class="card-title">{s.title}</div>
            <div class="card-desc">{s.description}</div>
          </a>
        ))}
      </div>

      {guideEntries.length > 0 && (
        <section class="story-guide">
          <h2>{editorial!.guideTitle}</h2>
          {guideEntries.map((g) => (
            <div class="guide-item">
              <h3><a href={localePath(`/stories/${g.story!.id}`, locale)}>{g.story!.title}</a></h3>
              <div class="guide-ref">{localizeBibleRef(g.story!.bibleRef, locale)}</div>
              <p>{g.text}</p>
            </div>
          ))}
        </section>
      )}
    </div>

    <div class="crosslink" style="max-width:700px;margin:0 auto 3rem;display:flex;gap:1.25rem;flex-wrap:wrap;">
      <a href={locale === "es" ? "/es/versiculo-del-dia/" : "/verse-of-the-day/"} style="flex:1;min-width:240px;background:var(--surface);border:1px solid var(--surface-border);border-radius:14px;padding:1.25rem 1.5rem;text-decoration:none;transition:border-color 0.2s;">
        <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--accent);margin-bottom:0.35rem;">{t(locale, "crosslink.verseTitle")}</div>
        <div style="color:var(--text-secondary);font-size:0.9rem;line-height:1.5;margin-bottom:0.5rem;">{t(locale, "crosslink.verseDesc")}</div>
        <span style="color:var(--primary);font-weight:600;font-size:0.85rem;">{t(locale, "crosslink.verseLink")}</span>
      </a>
      <a href={localePath("/widget", locale)} style="flex:1;min-width:240px;background:linear-gradient(135deg,rgba(200,162,255,0.08),rgba(107,92,231,0.08));border:1px solid rgba(200,162,255,0.2);border-radius:14px;padding:1.25rem 1.5rem;text-decoration:none;transition:border-color 0.2s;">
        <div style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--accent);margin-bottom:0.35rem;">📱 Widget</div>
        <div style="color:var(--text-secondary);font-size:0.9rem;line-height:1.5;margin-bottom:0.5rem;">{t(locale, "crosslink.widgetLink").replace(" →", "")}</div>
        <span style="color:var(--primary);font-weight:600;font-size:0.85rem;">{t(locale, "crosslink.widgetLink")}</span>
      </a>
    </div>

    <section class="faq-section" style="max-width:700px;margin:0 auto;padding:3rem 2rem;">
      <h2>{t(locale, "playlist.faqTitle")}</h2>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    {otherPlaylists.length > 0 && (
      <section class="more-playlists">
        <h2>{t(locale, "playlist.moreCollections")}</h2>
        <div class="playlists-row">
          {otherPlaylists.map((p) => (
            <a href={localePath(`/playlists/${p.id}`, locale)} class="playlist-card">
              <div class="pc-name">{p.name}</div>
              <div class="pc-count">{p.stories.length} {t(locale, "playlists.storyCount")}</div>
              <div class="pc-desc">{p.description}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="bottom-cta">
      <h2>{t(locale, "playlist.listenOn")}</h2>
      <p>{t(locale, "playlist.listenOnDesc")}</p>
      <StoreButtons variant="hero" />
    </section>
  </main>
</Base>
